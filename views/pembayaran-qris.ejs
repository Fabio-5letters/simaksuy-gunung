<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pembayaran QRIS - SIMAKSI Gunung</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
      * { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
      .gradient-header { background: linear-gradient(135deg, #1e5631 0%, #2d7a3e 50%, #3a9f5d 100%); }
      .btn-pay { background: linear-gradient(135deg, #1e5631 0%, #3a9f5d 100%); transition: all 0.3s ease; }
      .btn-pay:hover { transform: translateY(-2px); box-shadow: 0 10px 25px rgba(30, 86, 49, 0.3); }
      .pulse { animation: pulse 2s infinite; }
      @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.7; }
      }
      .countdown { font-variant-numeric: tabular-nums; }
    </style>
</head>
<body class="bg-gradient-to-br from-gray-50 to-gray-100 min-h-screen">

    <!-- Navbar -->
    <header class="gradient-header text-white shadow-xl sticky top-0 z-50">
        <div class="container mx-auto flex justify-between items-center py-4 px-6">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center">
                    <i class="fas fa-mountain text-green-700 text-lg"></i>
                </div>
                <h1 class="text-2xl font-bold">SIMAKSI Gunung</h1>
            </div>
            <a href="/pendakian" class="text-white hover:text-green-200 transition">
                <i class="fas fa-arrow-left mr-2"></i>Kembali
            </a>
        </div>
    </header>

    <!-- Progress Steps -->
    <div class="bg-white shadow-sm border-b">
        <div class="container mx-auto px-6 py-4">
            <div class="flex items-center justify-center space-x-4">
                <div class="flex items-center">
                    <div class="w-8 h-8 rounded-full bg-green-600 text-white flex items-center justify-center font-bold text-sm">1</div>
                    <span class="ml-2 text-sm font-medium text-green-600">Formulir</span>
                </div>
                <div class="w-12 h-0.5 bg-green-600"></div>
                <div class="flex items-center">
                    <div class="w-8 h-8 rounded-full bg-green-600 text-white flex items-center justify-center font-bold text-sm">2</div>
                    <span class="ml-2 text-sm font-medium text-green-600">Pembayaran</span>
                </div>
                <div class="w-12 h-0.5 bg-gray-300"></div>
                <div class="flex items-center">
                    <div class="w-8 h-8 rounded-full bg-gray-200 text-gray-500 flex items-center justify-center font-bold text-sm">3</div>
                    <span class="ml-2 text-sm font-medium text-gray-500">Unggah Bukti</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="container mx-auto px-6 py-10 max-w-3xl">
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
            <!-- Header -->
            <div class="gradient-header text-white p-6 text-center">
                <div class="w-16 h-16 bg-white bg-opacity-20 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-wallet text-3xl"></i>
                </div>
                <h2 class="text-2xl font-bold mb-2">Instruksi Pembayaran</h2>
                <p class="text-green-100">Silakan pilih metode dan selesaikan pembayaran Anda</p>
            </div>

            <div class="p-8">
                <!-- Payment Method Selection -->
                <div class="mb-8">
                    <label class="block text-gray-700 text-sm font-bold mb-4 uppercase tracking-wider text-center">Pilih Metode Pembayaran</label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <button type="button" onclick="switchPayment('QRIS')" id="btn-method-qris" class="relative flex items-center p-4 border-2 border-green-500 rounded-2xl cursor-pointer transition-all bg-green-50 shadow-sm">
                            <div class="w-10 h-10 bg-green-100 text-green-600 rounded-xl flex items-center justify-center mr-4">
                                <i class="fas fa-qrcode text-xl"></i>
                            </div>
                            <div class="text-left">
                                <p class="font-bold text-gray-900">QRIS</p>
                                <p class="text-[10px] text-gray-500">Gopay, OVO, Dana, LinkAja</p>
                            </div>
                            <div id="check-qris" class="absolute top-4 right-4 text-green-600">
                                <i class="fas fa-check-circle"></i>
                            </div>
                        </button>
                        <button type="button" onclick="switchPayment('BANK')" id="btn-method-bank" class="relative flex items-center p-4 border-2 border-gray-100 rounded-2xl cursor-pointer transition-all bg-white hover:border-blue-300">
                            <div class="w-10 h-10 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center mr-4">
                                <i class="fas fa-university text-xl"></i>
                            </div>
                            <div class="text-left">
                                <p class="font-bold text-gray-900">Transfer Bank</p>
                                <p class="text-[10px] text-gray-500">BCA, Mandiri, BNI, BRI</p>
                            </div>
                            <div id="check-bank" class="absolute top-4 right-4 text-blue-600 hidden">
                                <i class="fas fa-check-circle"></i>
                            </div>
                        </button>
                    </div>
                </div>

                <!-- QRIS Code Section -->
                <div id="section-qris" class="text-center mb-6">
                    <div class="bg-white border-2 border-dashed border-green-300 rounded-xl p-8 inline-block shadow-inner">
                        <div class="bg-white p-4 rounded-lg">
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=<%= pemesanan.kode_booking %>&color=1e5631" 
                                 alt="QR Code Pembayaran" 
                                 class="w-64 h-64 mx-auto">
                        </div>
                        <p class="text-sm text-gray-500 mt-4">
                            <i class="fas fa-info-circle mr-1"></i>
                            Scan QR Code menggunakan aplikasi e-wallet atau mobile banking
                        </p>
                    </div>
                </div>

                <!-- Bank Transfer Section -->
                <div id="section-bank" class="bg-white border-2 border-dashed border-blue-300 rounded-xl p-8 mb-6 hidden">
                    <h4 class="text-center font-bold text-gray-700 mb-6 uppercase tracking-wider">Rekening Pembayaran</h4>
                    <div class="space-y-4">
                        <div class="flex items-center justify-between p-4 bg-gray-50 rounded-xl border border-gray-100">
                            <div class="flex items-center">
                                <div class="w-12 h-8 bg-blue-600 rounded flex items-center justify-center text-white font-bold text-[10px] mr-3">BCA</div>
                                <div>
                                    <p class="text-xs text-gray-500">Nomor Rekening</p>
                                    <p class="font-mono font-bold text-gray-900">8010 2938 44</p>
                                </div>
                            </div>
                            <button onclick="navigator.clipboard.writeText('8010293844')" class="text-blue-600 hover:text-blue-700"><i class="fas fa-copy"></i></button>
                        </div>
                        <div class="flex items-center justify-between p-4 bg-gray-50 rounded-xl border border-gray-100">
                            <div class="flex items-center">
                                <div class="w-12 h-8 bg-orange-500 rounded flex items-center justify-center text-white font-bold text-[10px] mr-3">MANDIRI</div>
                                <div>
                                    <p class="text-xs text-gray-500">Nomor Rekening</p>
                                    <p class="font-mono font-bold text-gray-900">137 000 992 11</p>
                                </div>
                            </div>
                            <button onclick="navigator.clipboard.writeText('13700099211')" class="text-blue-600 hover:text-blue-700"><i class="fas fa-copy"></i></button>
                        </div>
                    </div>
                    <p class="text-center text-xs text-gray-500 mt-6 italic text-blue-800">
                        A/N <strong>PT SIMAKSI GUNUNG INDONESIA</strong>
                    </p>
                </div>

                <!-- Total Payment -->
                <div class="bg-gradient-to-r from-green-50 to-emerald-50 rounded-xl p-6 mb-6 border border-green-200">
                    <div class="flex justify-between items-center">
                        <div>
                            <p class="text-sm text-green-700 font-medium">Total Pembayaran</p>
                            <p class="text-xs text-green-600 mt-1">
                                <%= pemesanan.jumlah_anggota %> orang × <%= formatRupiah(pemesanan.harga_per_orang) %>
                            </p>
                        </div>
                        <p class="text-3xl font-black text-green-700"><%= formatRupiah(pemesanan.total_bayar) %></p>
                    </div>
                </div>

                <!-- Timer / Info -->
                <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6 text-center">
                    <p class="text-sm text-yellow-800">
                        <i class="fas fa-clock mr-2 pulse"></i>
                        Selesaikan pembayaran dalam <span class="font-bold countdown" id="countdown">15:00</span> menit
                    </p>
                </div>

                <!-- Action Buttons -->
                <div class="flex flex-col sm:flex-row gap-4">
                    <form action="/konfirmasi-bayar/<%= pemesanan.kode_booking %>" method="POST" class="flex-1">
                        <input type="hidden" name="final_metode" id="final_metode" value="QRIS">
                        <button type="submit" class="w-full btn-pay text-white font-bold py-4 px-6 rounded-xl flex items-center justify-center text-lg">
                            <i class="fas fa-check-circle mr-2"></i>
                            Saya Sudah Bayar
                        </button>
                    </form>
                    <a href="/pendakian" class="flex-1 bg-gray-200 text-gray-700 font-bold py-4 px-6 rounded-xl flex items-center justify-center text-lg hover:bg-gray-300 transition">
                        <i class="fas fa-times-circle mr-2"></i>
                        Batal
                    </a>
                </div>
            </div>
        </div>
        
        <!-- Order Summary Card (at bottom) -->
        <div class="mt-8 bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
            <h3 class="text-sm font-bold text-gray-900 mb-4 uppercase tracking-wide flex items-center">
                <i class="fas fa-receipt text-green-600 mr-2"></i>Detail Pemesanan
            </h3>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div>
                    <p class="text-[10px] text-gray-500 uppercase font-bold">Kode Booking</p>
                    <p class="font-mono font-bold text-green-700"><%= pemesanan.kode_booking %></p>
                </div>
                <div>
                    <p class="text-[10px] text-gray-500 uppercase font-bold">Tujuan</p>
                    <p class="font-semibold text-gray-900 text-xs"><%= pemesanan.nama_gunung %></p>
                </div>
                <div>
                    <p class="text-[10px] text-gray-500 uppercase font-bold">Tanggal</p>
                    <p class="font-semibold text-gray-900 text-xs"><%= new Date(pemesanan.tanggal_masuk).toLocaleDateString('id-ID', {day:'numeric', month:'short'}) %></p>
                </div>
                <div>
                    <p class="text-[10px] text-gray-500 uppercase font-bold">Anggota</p>
                    <p class="font-semibold text-gray-900 text-xs"><%= pemesanan.jumlah_anggota %> Orang</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        function switchPayment(method) {
            const sectionQris = document.getElementById('section-qris');
            const sectionBank = document.getElementById('section-bank');
            const btnQris = document.getElementById('btn-method-qris');
            const btnBank = document.getElementById('btn-method-bank');
            const checkQris = document.getElementById('check-qris');
            const checkBank = document.getElementById('check-bank');
            const finalInput = document.getElementById('final_metode');

            if (method === 'QRIS') {
                sectionQris.classList.remove('hidden');
                sectionBank.classList.add('hidden');
                btnQris.className = 'relative flex items-center p-4 border-2 border-green-500 rounded-2xl cursor-pointer transition-all bg-green-50 shadow-sm';
                btnBank.className = 'relative flex items-center p-4 border-2 border-gray-100 rounded-2xl cursor-pointer transition-all bg-white hover:border-blue-300';
                checkQris.classList.remove('hidden');
                checkBank.classList.add('hidden');
                finalInput.value = 'QRIS';
            } else {
                sectionQris.classList.add('hidden');
                sectionBank.classList.remove('hidden');
                btnBank.className = 'relative flex items-center p-4 border-2 border-blue-500 rounded-2xl cursor-pointer transition-all bg-blue-50 shadow-sm';
                btnQris.className = 'relative flex items-center p-4 border-2 border-gray-100 rounded-2xl cursor-pointer transition-all bg-white hover:border-green-300';
                checkBank.classList.remove('hidden');
                checkQris.classList.add('hidden');
                finalInput.value = 'Transfer Bank';
            }
        }
    </script>

    <!-- Footer -->
    <footer class="gradient-header text-white py-8 mt-12">
        <div class="container mx-auto px-6 text-center text-green-100 text-sm">
            <p>&copy; 2026 SIMAKSI - Sistem Informasi Manajemen Pendakian Gunung</p>
        </div>
    </footer>

    <!-- Countdown Timer Script -->
    <script>
        // 15 minute countdown
        let timeLeft = 15 * 60; // 15 minutes in seconds
        const countdownEl = document.getElementById('countdown');

        const timer = setInterval(() => {
            const minutes = Math.floor(timeLeft / 60);
            const seconds = timeLeft % 60;
            countdownEl.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
            timeLeft--;

            if (timeLeft < 0) {
                clearInterval(timer);
                window.location.href = '/pendakian';
            }
        }, 1000);
    </script>
</body>
</html>
