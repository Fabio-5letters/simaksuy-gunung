<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Berita - SIMAKSI Gunung Merbabu</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
      * {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      }
      .navbar-gradient {
        background: linear-gradient(135deg, #1e5631 0%, #2d7a3e 50%, #3a9f5d 100%);
      }
      .card-hover {
        transition: all 0.3s ease;
      }
      .card-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(30, 86, 49, 0.15);
      }
      .btn-cta {
        background: linear-gradient(135deg, #1e5631 0%, #3a9f5d 100%);
        transition: all 0.3s ease;
      }
      .btn-cta:hover {
        transform: scale(1.05);
        box-shadow: 0 10px 25px rgba(30, 86, 49, 0.3);
      }
    </style>
    <link rel="stylesheet" href="/css/style.css">
    <link href="/css/output.css" rel="stylesheet">
</head>
<body class="bg-gray-50">
    <div class="min-h-screen">
        <!-- Navbar -->
        <header class="navbar-gradient text-white shadow-xl sticky top-0 z-50">
            <div class="container mx-auto flex justify-between items-center py-4 px-6">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center">
                        <i class="fas fa-mountain text-green-700 text-lg"></i>
                    </div>
                    <h1 class="text-2xl font-bold">SIMAKSI Gunung</h1>
                </div>
                <nav class="hidden md:block">
                    <ul class="flex space-x-8 font-semibold">
                        <li><a href="/" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-home"></i><span>Beranda</span></a></li>
                        <li><a href="/berita" class="text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-newspaper"></i><span>Berita</span></a></li>
                        <li><a href="/pendakian" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-person-hiking"></i><span>Pendakian</span></a></li>
                        <li><a href="/cuaca" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-cloud-sun"></i><span>Cuaca</span></a></li>
                        <li><a href="/status" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-chart-line"></i><span>Status</span></a></li>
                        <li><a href="/panduan" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-download"></i><span>Panduan</span></a></li>
                        <li><a href="/kontak" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-envelope"></i><span>Kontak</span></a></li>
                    </ul>
                </nav>
                <div class="flex space-x-4">
                    <% if (user) { %>
                        <!-- User Profile Dropdown -->
                        <div class="relative">
                            <button id="profile-btn" class="flex items-center space-x-3 bg-white text-green-700 px-4 py-2 rounded-lg font-semibold hover:bg-green-50 transition">
                                <div class="w-8 h-8 bg-green-600 rounded-full flex items-center justify-center">
                                    <i class="fas fa-user text-white text-sm"></i>
                                </div>
                                <span><%= user.nama %></span>
                                <i class="fas fa-chevron-down text-sm"></i>
                            </button>
                            <div id="profile-dropdown" class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 hidden z-50">
                                <div class="py-2">
                                    <div class="px-4 py-2 border-b border-gray-100">
                                        <p class="text-sm font-medium text-gray-900"><%= user.nama %></p>
                                        <p class="text-xs text-gray-500"><%= user.email %></p>
                                    </div>
                                    <a href="/profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition">
                                        <i class="fas fa-user-circle mr-2"></i>Profile Saya
                                    </a>
                                    <a href="/riwayat" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition">
                                        <i class="fas fa-history mr-2"></i>Riwayat Pendakian
                                    </a>
                                    <div class="border-t border-gray-100"></div>
                                    <a href="/logout" class="block px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition">
                                        <i class="fas fa-sign-out-alt mr-2"></i>Logout
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% } else { %>
                        <a href="/login" class="bg-white text-green-700 px-6 py-2 rounded-lg font-semibold hover:bg-green-50 transition">Login</a>
                    <% } %>
                </div>
            </div>
        </header>

        <!-- Hero Section -->
        <section class="bg-gradient-to-r from-green-600 to-green-800 text-white py-20 px-6">
            <div class="container mx-auto text-center">
                <h2 class="text-5xl md:text-6xl font-black mb-6 drop-shadow-lg">Berita & Informasi</h2>
                <p class="text-xl md:text-2xl text-green-100 max-w-2xl mx-auto drop-shadow-md">Informasi terkini tentang aktivitas gunung, tips pendakian, dan berita terkait konservasi alam</p>
            </div>
        </section>

        <!-- Berita Content -->
        <section class="py-20 bg-white">
            <div class="container mx-auto px-6">
                <!-- Search Bar -->
                <div class="max-w-2xl mx-auto mb-12">
                    <form action="/berita" method="GET" class="flex shadow-lg rounded-lg overflow-hidden">
                        <input type="text" name="search" value="<%= search || '' %>" placeholder="Cari berita..." class="flex-1 px-6 py-4 border-none focus:outline-none focus:ring-2 focus:ring-green-500 text-lg">
                        <button type="submit" class="bg-green-600 text-white px-8 py-4 hover:bg-green-700 transition font-bold text-lg">
                            <i class="fas fa-search mr-2"></i>Cari
                        </button>
                    </form>
                    <% if (search) { %>
                        <p class="text-sm text-gray-600 mt-4 text-center">
                            Hasil pencarian untuk: "<strong><%= search %></strong>" 
                            <a href="/berita" class="text-green-600 hover:text-green-700 ml-2 font-semibold underline">Hapus filter</a>
                        </p>
                    <% } %>
                </div>

                <% if (berita && berita.length > 0) { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
                        <% berita.forEach(item => { %>
                            <div class="card-hover bg-white rounded-2xl overflow-hidden shadow-xl border border-gray-100">
                                <div class="h-56 overflow-hidden bg-gradient-to-br from-green-400 to-green-600 relative">
                                    <img src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=500&h=300&fit=crop" alt="Berita" class="w-full h-full object-cover opacity-90 transition duration-500 hover:scale-110">
                                    <div class="absolute top-4 right-4 bg-white px-3 py-1 rounded-full shadow-md">
                                        <span class="text-green-700 text-xs font-bold uppercase tracking-wider">Terbaru</span>
                                    </div>
                                </div>
                                <div class="p-8">
                                    <h3 class="text-2xl font-bold mb-4 text-gray-900 line-clamp-2 leading-tight"><%= item.judul %></h3>
                                    <p class="text-gray-600 mb-6 line-clamp-3 text-sm leading-relaxed"><%= item.isi_berita.substring(0, 150) %>...</p>
                                    <a href="/berita/<%= item.id %>" class="inline-flex items-center text-green-600 hover:text-green-700 font-bold transition group">
                                        Baca Selengkapnya <i class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform"></i>
                                    </a>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="text-center py-20 bg-gray-50 rounded-3xl border-2 border-dashed border-gray-200">
                        <i class="fas fa-newspaper text-8xl text-gray-300 mb-6"></i>
                        <h3 class="text-3xl font-bold text-gray-600 mb-2">Belum ada berita</h3>
                        <p class="text-gray-500 text-lg">Berita akan segera ditambahkan oleh admin.</p>
                        <a href="/berita" class="mt-8 inline-block bg-green-600 text-white px-8 py-3 rounded-lg font-bold hover:bg-green-700 transition">Lihat Semua Berita</a>
                    </div>
                <% } %>
            </div>

            <!-- Pagination -->
            <% if (totalPages > 1) { %>
                <div class="flex justify-center items-center space-x-3 mt-16">
                    <% if (currentPage > 1) { %>
                        <a href="?page=<%= currentPage - 1 %>" class="w-12 h-12 flex items-center justify-center bg-white border-2 border-gray-200 rounded-xl hover:border-green-500 hover:text-green-600 transition shadow-sm">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    <% } %>

                    <% for (let i = 1; i <= totalPages; i++) { %>
                        <a href="?page=<%= i %>" class="w-12 h-12 flex items-center justify-center rounded-xl font-bold transition shadow-sm <%= i === currentPage ? 'bg-green-600 text-white scale-110' : 'bg-white border-2 border-gray-200 hover:border-green-500 hover:text-green-600' %>">
                            <%= i %>
                        </a>
                    <% } %>

                    <% if (currentPage < totalPages) { %>
                        <a href="?page=<%= currentPage + 1 %>" class="w-12 h-12 flex items-center justify-center bg-white border-2 border-gray-200 rounded-xl hover:border-green-500 hover:text-green-600 transition shadow-sm">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    <% } %>
                </div>
                <p class="text-center text-sm font-medium text-gray-500 mt-6 tracking-wide uppercase">
                    Menampilkan <%= ((currentPage - 1) * 6) + 1 %>-<%= (currentPage * 6 < total) ? currentPage * 6 : total %> dari <%= total %> berita
                </p>
            <% } %>
        </div>
    </section>

        <!-- Footer -->
        <footer class="navbar-gradient text-white py-12">
            <div class="container mx-auto px-6">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
                    <div>
                        <h4 class="text-lg font-bold mb-4 flex items-center"><i class="fas fa-mountain mr-2"></i>SIMAKSI</h4>
                        <p class="text-green-100 text-sm">Platform terpercaya untuk mendaftar pendakian gunung di Indonesia</p>
                    </div>
                    <div>
                        <h4 class="text-lg font-bold mb-4">Navigasi</h4>
                        <ul class="space-y-2 text-green-100 text-sm">
                            <li><a href="/" class="hover:text-white transition">Beranda</a></li>
                            <li><a href="/berita" class="hover:text-white transition">Berita</a></li>
                            <li><a href="/pendakian" class="hover:text-white transition">Pendakian</a></li>
                            <li><a href="/kontak" class="hover:text-white transition">Kontak</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="text-lg font-bold mb-4">Bantuan</h4>
                        <ul class="space-y-2 text-green-100 text-sm">
                            <li><a href="/faq" class="hover:text-white transition">FAQ</a></li>
                            <li><a href="/panduan" class="hover:text-white transition">Panduan Pendakian</a></li>
                            <li><a href="/keselamatan" class="hover:text-white transition">Keselamatan</a></li>
                            <li><a href="/syarat-ketentuan" class="hover:text-white transition">Syarat & Ketentuan</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="text-lg font-bold mb-4">Hubungi Kami</h4>
                        <ul class="space-y-2 text-green-100 text-sm">
                            <li class="flex items-center"><i class="fas fa-phone mr-2"></i>+62 274 515 912</li>
                            <li class="flex items-center"><i class="fas fa-envelope mr-2"></i>info@simaksi.com</li>
                            <li class="flex items-center"><i class="fas fa-map-marker-alt mr-2"></i>Semarang, Indonesia</li>
                        </ul>
                    </div>
                </div>
                <div class="border-t border-green-700 pt-8 text-center text-green-100 text-sm">
                    <p>&copy; 2026 SIMAKSI - Sistem Informasi Manajemen Pendakian Gunung. All rights reserved.</p>
                    <div class="flex justify-center space-x-4 mt-4">
                        <a href="#" class="hover:text-white transition"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="hover:text-white transition"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="hover:text-white transition"><i class="fab fa-youtube"></i></a>
                        <a href="#" class="hover:text-white transition"><i class="fab fa-twitter"></i></a>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <!-- Profile Dropdown Script -->
    <script>
        // Profile dropdown functionality
        const profileBtn = document.getElementById('profile-btn');
        const profileDropdown = document.getElementById('profile-dropdown');

        if (profileBtn && profileDropdown) {
            profileBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                profileDropdown.classList.toggle('hidden');
            });

            // Close dropdown when clicking outside
            document.addEventListener('click', function(e) {
                if (!profileBtn.contains(e.target) && !profileDropdown.contains(e.target)) {
                    profileDropdown.classList.add('hidden');
                }
            });

            // Close dropdown on escape key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    profileDropdown.classList.add('hidden');
                }
            });
        }
    </script>
</body>
</html>