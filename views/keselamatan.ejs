<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Keselamatan Pendakian - SIMAKSI Gunung Merbabu</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
      * {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      }
      .navbar-gradient {
        background: linear-gradient(135deg, #1e5631 0%, #2d7a3e 50%, #3a9f5d 100%);
      }
      .safety-card {
        transition: all 0.3s ease;
      }
      .safety-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(30, 86, 49, 0.1);
      }
    </style>
    <link rel="stylesheet" href="/css/style.css">
    <link href="/css/output.css" rel="stylesheet">
</head>
<body class="bg-gray-50 min-h-screen">
    <div class="flex flex-col min-h-screen">
        <!-- Navbar -->
        <header class="navbar-gradient text-white shadow-xl sticky top-0 z-50">
            <div class="container mx-auto flex justify-between items-center py-4 px-6">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center">
                        <i class="fas fa-mountain text-green-700 text-lg"></i>
                    </div>
                    <h1 class="text-2xl font-bold">SIMAKSI Gunung</h1>
                </div>
                <nav class="hidden md:block">
                    <ul class="flex space-x-8 font-semibold">
                        <li><a href="/" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-home"></i><span>Beranda</span></a></li>
                        <li><a href="/berita" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-newspaper"></i><span>Berita</span></a></li>
                        <li><a href="/pendakian" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-person-hiking"></i><span>Pendakian</span></a></li>
                        <li><a href="/cuaca" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-cloud-sun"></i><span>Cuaca</span></a></li>
                        <li><a href="/status" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-chart-line"></i><span>Status</span></a></li>
                        <li><a href="/panduan" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-download"></i><span>Panduan</span></a></li>
                        <li><a href="/kontak" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-envelope"></i><span>Kontak</span></a></li>
                    </ul>
                </nav>
                <div class="flex space-x-4">
                    <% if (user) { %>
                        <div class="relative">
                            <button id="profile-btn" class="flex items-center space-x-3 bg-white text-green-700 px-4 py-2 rounded-lg font-semibold hover:bg-green-50 transition">
                                <div class="w-8 h-8 bg-green-600 rounded-full flex items-center justify-center text-white text-sm">
                                    <i class="fas fa-user"></i>
                                </div>
                                <span><%= user.nama %></span>
                                <i class="fas fa-chevron-down text-sm"></i>
                            </button>
                            <div id="profile-dropdown" class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 hidden z-50">
                                <div class="py-2">
                                    <div class="px-4 py-2 border-b border-gray-100">
                                        <p class="text-sm font-medium text-gray-900"><%= user.nama %></p>
                                        <p class="text-xs text-gray-500"><%= user.email %></p>
                                    </div>
                                    <a href="/profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition">
                                        <i class="fas fa-user-circle mr-2"></i>Profile Saya
                                    </a>
                                    <a href="/riwayat" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition">
                                        <i class="fas fa-history mr-2"></i>Riwayat Pendakian
                                    </a>
                                    <div class="border-t border-gray-100"></div>
                                    <a href="/logout" class="block px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition">
                                        <i class="fas fa-sign-out-alt mr-2"></i>Logout
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% } else { %>
                        <a href="/login" class="bg-white text-green-700 px-6 py-2 rounded-lg font-semibold hover:bg-green-50 transition">Login</a>
                    <% } %>
                </div>
            </div>
        </header>

        <!-- Hero Section -->
        <section class="bg-gradient-to-r from-red-600 to-red-800 text-white py-16 px-6">
            <div class="container mx-auto text-center">
                <h2 class="text-4xl md:text-5xl font-black mb-4 uppercase tracking-tighter">Keselamatan Adalah Utama</h2>
                <p class="text-xl text-red-100 max-w-2xl mx-auto">Panduan lengkap prosedur keselamatan dan etika pendakian demi kenyamanan bersama</p>
            </div>
        </section>

        <!-- Safety Content -->
        <section class="py-20 flex-grow bg-white">
            <div class="container mx-auto px-6 max-w-6xl">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                    <!-- Cards -->
                    <div class="safety-card bg-green-50 rounded-3xl p-10 border border-green-100 shadow-sm">
                        <div class="w-20 h-20 bg-white rounded-3xl flex items-center justify-center mb-8 shadow-lg">
                            <i class="fas fa-heartbeat text-3xl text-green-600"></i>
                        </div>
                        <h3 class="text-2xl font-black text-gray-900 mb-6 uppercase tracking-tight">1. Persiapan Fisik</h3>
                        <ul class="space-y-4 font-medium text-gray-600">
                            <li class="flex items-start"><i class="fas fa-check-circle text-green-500 mt-1 mr-3"></i>Latihan fisik rutin minimal 2 minggu sebelum pendakian (Jogging, Berenang, dll).</li>
                            <li class="flex items-start"><i class="fas fa-check-circle text-green-500 mt-1 mr-3"></i>Pastikan kondisi tubuh dalam keadaan sehat dan fit.</li>
                            <li class="flex items-start"><i class="fas fa-check-circle text-green-500 mt-1 mr-3"></i>Istirahat cukup (7-8 jam) sebelum memulai perjalanan.</li>
                        </ul>
                    </div>

                    <div class="safety-card bg-blue-50 rounded-3xl p-10 border border-blue-100 shadow-sm">
                        <div class="w-20 h-20 bg-white rounded-3xl flex items-center justify-center mb-8 shadow-lg">
                            <i class="fas fa-briefcase text-3xl text-blue-600"></i>
                        </div>
                        <h3 class="text-2xl font-black text-gray-900 mb-6 uppercase tracking-tight">2. Perlengkapan Wajib</h3>
                        <ul class="space-y-4 font-medium text-gray-600">
                            <li class="flex items-start"><i class="fas fa-check-circle text-blue-500 mt-1 mr-3"></i>Membawa tenda, sleeping bag, dan matras yang sesuai standar.</li>
                            <li class="flex items-start"><i class="fas fa-check-circle text-blue-500 mt-1 mr-3"></i>Pakaian hangat (layering system) dan jas hujan/raincoat.</li>
                            <li class="flex items-start"><i class="fas fa-check-circle text-blue-500 mt-1 mr-3"></i>Peralatan P3K lengkap dan obat-obatan pribadi.</li>
                        </ul>
                    </div>

                    <div class="safety-card bg-amber-50 rounded-3xl p-10 border border-amber-100 shadow-sm">
                        <div class="w-20 h-20 bg-white rounded-3xl flex items-center justify-center mb-8 shadow-lg">
                            <i class="fas fa-cloud-sun text-3xl text-amber-600"></i>
                        </div>
                        <h3 class="text-2xl font-black text-gray-900 mb-6 uppercase tracking-tight">3. Waspada Cuaca</h3>
                        <ul class="space-y-4 font-medium text-gray-600">
                            <li class="flex items-start"><i class="fas fa-check-circle text-amber-500 mt-1 mr-3"></i>Pantau prakiraan cuaca terkini melalui menu Cuaca di website kami.</li>
                            <li class="flex items-start"><i class="fas fa-check-circle text-amber-500 mt-1 mr-3"></i>Segera cari tempat berlindung jika terjadi badai atau petir.</li>
                            <li class="flex items-start"><i class="fas fa-check-circle text-amber-500 mt-1 mr-3"></i>Jangan memaksakan muncak jika kabut terlalu tebal.</li>
                        </ul>
                    </div>

                    <div class="safety-card bg-emerald-50 rounded-3xl p-10 border border-emerald-100 shadow-sm">
                        <div class="w-20 h-20 bg-white rounded-3xl flex items-center justify-center mb-8 shadow-lg">
                            <i class="fas fa-leaf text-3xl text-emerald-600"></i>
                        </div>
                        <h3 class="text-2xl font-black text-gray-900 mb-6 uppercase tracking-tight">4. Etika Lingkungan</h3>
                        <ul class="space-y-4 font-medium text-gray-600">
                            <li class="flex items-start"><i class="fas fa-check-circle text-emerald-500 mt-1 mr-3"></i>Leave No Trace: Bawa kembali semua sampah Anda ke basecamp.</li>
                            <li class="flex items-start"><i class="fas fa-check-circle text-emerald-500 mt-1 mr-3"></i>Dilarang merusak vegetasi atau mengganggu ekosistem satwa liar.</li>
                            <li class="flex items-start"><i class="fas fa-check-circle text-emerald-500 mt-1 mr-3"></i>Gunakan jalur resmi yang telah ditentukan oleh pengelola.</li>
                        </ul>
                    </div>
                </div>

                <!-- Emergency Contacts -->
                <div class="mt-20 bg-gray-900 rounded-3xl p-12 text-white relative overflow-hidden shadow-2xl">
                    <div class="absolute top-0 right-0 p-8 opacity-10">
                        <i class="fas fa-phone-alt text-9xl"></i>
                    </div>
                    <div class="relative z-10">
                        <h3 class="text-3xl font-black mb-8 uppercase tracking-widest flex items-center">
                            <i class="fas fa-ambulance text-red-500 mr-4"></i>Kontak Darurat
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            <div class="bg-white bg-opacity-10 p-6 rounded-2xl backdrop-blur-md border border-white border-opacity-10">
                                <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Basecamp Rescue</p>
                                <p class="text-3xl font-black text-green-400">+62 274 515 912</p>
                                <p class="text-sm mt-2 text-gray-300 italic">"Tersedia 24 jam untuk bantuan medis dan evakuasi"</p>
                            </div>
                            <div class="bg-white bg-opacity-10 p-6 rounded-2xl backdrop-blur-md border border-white border-opacity-10">
                                <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">SAR Nasional</p>
                                <p class="text-3xl font-black text-red-400">115</p>
                                <p class="text-sm mt-2 text-gray-300 italic">"Layanan darurat pencarian dan pertolongan (Nasional)"</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer class="navbar-gradient text-white py-12">
            <div class="container mx-auto px-6">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
                    <div>
                        <h4 class="text-lg font-bold mb-4 flex items-center"><i class="fas fa-mountain mr-2"></i>SIMAKSI</h4>
                        <p class="text-green-100 text-sm">Platform terpercaya untuk mendaftar pendakian gunung di Indonesia</p>
                    </div>
                    <div>
                        <h4 class="text-lg font-bold mb-4">Navigasi</h4>
                        <ul class="space-y-2 text-green-100 text-sm">
                            <li><a href="/" class="hover:text-white transition">Beranda</a></li>
                            <li><a href="/berita" class="hover:text-white transition">Berita</a></li>
                            <li><a href="/pendakian" class="hover:text-white transition">Pendakian</a></li>
                            <li><a href="/kontak" class="hover:text-white transition">Kontak</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="text-lg font-bold mb-4">Bantuan</h4>
                        <ul class="space-y-2 text-green-100 text-sm">
                            <li><a href="/faq" class="hover:text-white transition">FAQ</a></li>
                            <li><a href="/panduan" class="hover:text-white transition">Panduan Pendakian</a></li>
                            <li><a href="/keselamatan" class="hover:text-white transition">Keselamatan</a></li>
                            <li><a href="/syarat-ketentuan" class="hover:text-white transition">Syarat & Ketentuan</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="text-lg font-bold mb-4">Hubungi Kami</h4>
                        <ul class="space-y-2 text-green-100 text-sm">
                            <li class="flex items-center"><i class="fas fa-phone mr-2"></i>+62 274 515 912</li>
                            <li class="flex items-center"><i class="fas fa-envelope mr-2"></i>info@simaksi.com</li>
                            <li class="flex items-center"><i class="fas fa-map-marker-alt mr-2"></i>Jakarta, Indonesia</li>
                        </ul>
                    </div>
                </div>
                <div class="border-t border-green-700 pt-8 text-center text-green-100 text-sm">
                    <p>&copy; 2026 SIMAKSI - Sistem Informasi Manajemen Pendakian Gunung. All rights reserved.</p>
                </div>
            </div>
        </footer>
    </div>

    <!-- Script -->
    <script>
        const profileBtn = document.getElementById('profile-btn');
        const profileDropdown = document.getElementById('profile-dropdown');

        if (profileBtn && profileDropdown) {
            profileBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                profileDropdown.classList.toggle('hidden');
            });

            document.addEventListener('click', function(e) {
                if (!profileBtn.contains(e.target) && !profileDropdown.contains(e.target)) {
                    profileDropdown.classList.add('hidden');
                }
            });

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    profileDropdown.classList.add('hidden');
                }
            });
        }
    </script>
</body>
</html>