<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - SIMAKSI Gunung</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
      * { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
      .navbar-gradient { background: linear-gradient(135deg, #1e5631 0%, #2d7a3e 50%, #3a9f5d 100%); }
      .sidebar-item { transition: all 0.3s ease; }
      .sidebar-item.active { background-color: #f0fdf4; border-left: 4px solid #166534; color: #166534; }
      .card-icon { background-color: #f0fdf4; color: #166534; }
      .btn-primary { background-color: #166534; color: white; transition: all 0.3s ease; }
      .btn-primary:hover { background-color: #14532d; }
    </style>
</head>
<body class="bg-gray-50">
    <!-- Navbar -->
    <header class="navbar-gradient text-white shadow-xl sticky top-0 z-50">
        <div class="container mx-auto flex justify-between items-center py-4 px-6">
            <div class="flex items-center space-x-3">
                <a href="/" class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center">
                        <i class="fas fa-mountain text-green-700 text-lg"></i>
                    </div>
                    <h1 class="text-2xl font-bold">SIMAKSI Gunung</h1>
                </a>
            </div>
            <nav class="hidden md:block">
                <ul class="flex space-x-8 font-semibold">
                    <li><a href="/" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-home"></i><span>Beranda</span></a></li>
                    <li><a href="/berita" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-newspaper"></i><span>Berita</span></a></li>
                    <li><a href="/pendakian" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-person-hiking"></i><span>Pendakian</span></a></li>
                    <li><a href="/cuaca" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-cloud-sun"></i><span>Cuaca</span></a></li>
                    <li><a href="/status" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-chart-line"></i><span>Status</span></a></li>
                    <li><a href="/panduan" class="text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-book"></i><span>Panduan</span></a></li>
                    <li><a href="/kontak" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-envelope"></i><span>Kontak</span></a></li>
                </ul>
            </nav>
            <div class="flex space-x-4">
                <% if (user) { %>
                    <div class="relative group">
                        <button class="flex items-center space-x-2 bg-white text-green-700 px-4 py-2 rounded-lg font-semibold">
                            <i class="fas fa-user-circle"></i>
                            <span><%= user.nama.split(' ')[0] %></span>
                        </button>
                    </div>
                <% } else { %>
                    <a href="/login" class="bg-white text-green-700 px-6 py-2 rounded-lg font-semibold hover:bg-green-50 transition">Login</a>
                <% } %>
            </div>
        </div>
    </header>

    <main class="py-10">
        <div class="container mx-auto px-6">
            <!-- Breadcrumb -->
            <nav class="text-sm text-gray-500 mb-8 flex items-center space-x-2">
                <a href="/" class="hover:text-green-700">Beranda</a>
                <i class="fas fa-chevron-right text-xs"></i>
                <a href="/panduan" class="hover:text-green-700">Panduan</a>
                <i class="fas fa-chevron-right text-xs"></i>
                <span class="text-gray-900 font-semibold"><%= title %></span>
            </nav>

            <div class="flex flex-col lg:flex-row gap-8">
                <!-- Sidebar -->
                <aside class="w-full lg:w-1/4 space-y-6">
                    <!-- Navigation Menu -->
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                        <div class="p-4 border-b border-gray-50 bg-gray-50/50">
                            <h3 class="font-bold text-gray-900 flex items-center">
                                <i class="fas fa-list-ul mr-2 text-green-700"></i>Menu Panduan
                            </h3>
                        </div>
                        <nav class="py-2">
                            <% if (typeof allPanduan !== 'undefined' && allPanduan) { %>
                                <% allPanduan.forEach(p => { %>
                                    <a href="/panduan/<%= p.slug %>" class="sidebar-item block px-6 py-4 flex items-center space-x-3 <%= (typeof slug !== 'undefined' && slug === p.slug) ? 'active' : 'text-gray-600 hover:bg-gray-50' %>">
                                        <i class="fas <%= p.icon %> w-5"></i>
                                        <span class="font-medium"><%= p.title %></span>
                                    </a>
                                <% }) %>
                            <% } %>
                        </nav>
                    </div>

                    <!-- Safety Box -->
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                        <div class="w-12 h-12 bg-green-50 text-green-700 rounded-xl flex items-center justify-center mb-4">
                            <i class="fas fa-shield-alt text-xl"></i>
                        </div>
                        <h4 class="font-bold text-gray-900 mb-2">Utamakan Keselamatan</h4>
                        <p class="text-gray-600 text-sm mb-4">Selalu utamakan keselamatan dalam setiap pendakian. Persiapan yang matang adalah kunci utama.</p>
                        <a href="/panduan/keselamatan" class="text-green-700 font-bold text-sm flex items-center hover:underline">
                            Lihat Panduan Keselamatan <i class="fas fa-arrow-right ml-2 text-xs"></i>
                        </a>
                    </div>

                    <!-- Help Box -->
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                        <div class="w-12 h-12 bg-blue-50 text-blue-700 rounded-xl flex items-center justify-center mb-4">
                            <i class="fas fa-headset text-xl"></i>
                        </div>
                        <h4 class="font-bold text-gray-900 mb-2">Butuh Bantuan?</h4>
                        <p class="text-gray-600 text-sm mb-6">Jika ada pertanyaan atau membutuhkan bantuan lebih lanjut, jangan ragu untuk menghubungi kami.</p>
                        <a href="/kontak" class="btn-primary block w-full text-center py-3 rounded-xl font-bold text-sm">
                            Hubungi Kami
                        </a>
                    </div>
                </aside>

                <!-- Content Area -->
                <section class="w-full lg:w-3/4">
                    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
                        <!-- Header with Illustration -->
                        <div class="p-8 lg:p-12 relative overflow-hidden flex flex-col md:flex-row items-center">
                            <div class="relative z-10 md:w-2/3">
                                <h2 class="text-4xl font-bold text-gray-900 mb-4"><%= typeof title !== 'undefined' ? title : 'Panduan Pendakian' %></h2>
                                <p class="text-gray-600 text-lg leading-relaxed"><%= typeof description !== 'undefined' ? description : 'Pelajari panduan lengkap untuk mempersiapkan pendakian Anda.' %></p>
                            </div>
                            <div class="md:w-1/3 mt-8 md:mt-0 flex justify-center">
                                <div class="relative w-48 h-48 lg:w-64 lg:h-64 rounded-3xl overflow-hidden shadow-2xl transform rotate-3 hover:rotate-0 transition-all duration-500">
                                    <img src="<%= typeof headerImage !== 'undefined' ? headerImage : 'https://images.unsplash.com/photo-1551632432-c735e7a030be?auto=format&fit=crop&q=80&w=800' %>" alt="<%= typeof title !== 'undefined' ? title : 'Panduan' %>" class="w-full h-full object-cover">
                                </div>
                            </div>
                        </div>

                        <!-- Divider -->
                        <div class="px-8 lg:px-12">
                            <hr class="border-gray-100">
                        </div>

                        <!-- Sections -->
                        <div class="p-8 lg:p-12 space-y-12">
                            <% if (typeof sections !== 'undefined' && sections && sections.length > 0) { %>
                                <% sections.forEach((section, index) => { %>
                                    <div class="space-y-6">
                                        <h3 class="text-2xl font-bold text-gray-900 flex items-center">
                                            <span class="bg-green-700 text-white w-8 h-8 rounded-lg flex items-center justify-center mr-3 text-sm"><%= index + 1 %></span>
                                            <%= section.title %>
                                        </h3>
                                        
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                            <% if (section.items && section.items.length > 0) { %>
                                                <% section.items.forEach(item => { %>
                                                    <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100 hover:border-green-200 transition-all duration-300">
                                                        <div class="w-12 h-12 card-icon rounded-full flex items-center justify-center mb-4">
                                                            <i class="fas <%= item.icon || 'fa-check' %> text-xl"></i>
                                                        </div>
                                                        <h4 class="font-bold text-gray-900 mb-2"><%= item.title %></h4>
                                                        <p class="text-gray-600 text-sm leading-relaxed"><%= item.desc %></p>
                                                    </div>
                                                <% }) %>
                                            <% } %>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="text-center py-10">
                                    <p class="text-gray-500 italic">Informasi detail sedang diperbarui.</p>
                                </div>
                            <% } %>

                            <% if (slug === 'keselamatan') { %>
                                <!-- Emergency Contacts Section -->
                                <div class="mt-16 bg-red-600 rounded-3xl p-10 text-white relative overflow-hidden shadow-xl">
                                    <div class="absolute top-0 right-0 p-8 opacity-10">
                                        <i class="fas fa-phone-alt text-8xl"></i>
                                    </div>
                                    <div class="relative z-10">
                                        <h3 class="text-2xl font-bold mb-6 flex items-center">
                                            <i class="fas fa-ambulance mr-3"></i>Kontak Darurat
                                        </h3>
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                            <div class="bg-white/10 p-6 rounded-2xl border border-white/20 backdrop-blur-sm">
                                                <p class="text-xs font-bold text-red-100 uppercase tracking-wider mb-1">Basecamp Rescue</p>
                                                <p class="text-2xl font-bold text-white">+62 274 515 912</p>
                                            </div>
                                            <div class="bg-white/10 p-6 rounded-2xl border border-white/20 backdrop-blur-sm">
                                                <p class="text-xs font-bold text-red-100 uppercase tracking-wider mb-1">SAR Nasional</p>
                                                <p class="text-2xl font-bold text-white">115</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="navbar-gradient text-white py-12 mt-12">
        <div class="container mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
                <div>
                    <h4 class="text-lg font-bold mb-4 flex items-center"><i class="fas fa-mountain mr-2"></i>SIMAKSI</h4>
                    <p class="text-green-100 text-sm">Platform terpercaya untuk mendaftar pendakian gunung di Indonesia</p>
                </div>
                <div>
                    <h4 class="text-lg font-bold mb-4">Navigasi</h4>
                    <ul class="space-y-2 text-green-100 text-sm">
                        <li><a href="/" class="hover:text-white transition">Beranda</a></li>
                        <li><a href="/berita" class="hover:text-white transition">Berita</a></li>
                        <li><a href="/pendakian" class="hover:text-white transition">Pendakian</a></li>
                        <li><a href="/kontak" class="hover:text-white transition">Kontak</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-lg font-bold mb-4">Bantuan</h4>
                    <ul class="space-y-2 text-green-100 text-sm">
                        <li><a href="/faq" class="hover:text-white transition">FAQ</a></li>
                        <li><a href="/panduan" class="hover:text-white transition">Panduan Pendakian</a></li>
                        <li><a href="/keselamatan" class="hover:text-white transition">Keselamatan</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-lg font-bold mb-4">Hubungi Kami</h4>
                    <ul class="space-y-2 text-green-100 text-sm">
                        <li class="flex items-center"><i class="fas fa-phone mr-2"></i>+62 274 515 912</li>
                        <li class="flex items-center"><i class="fas fa-envelope mr-2"></i>info@simaksi.com</li>
                    </ul>
                </div>
            </div>
            <div class="border-t border-green-700 pt-8 text-center text-green-100 text-sm">
                <p>&copy; 2026 SIMAKSI. All rights reserved.</p>
            </div>
        </div>
    </footer>
</body>
</html>