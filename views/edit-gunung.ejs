<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Gunung - SIMAKSI Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100 min-h-screen">
  <div class="flex">
    <!-- Sidebar (Same as main manage page) -->
    <aside class="w-64 sidebar min-h-screen text-white p-6 sticky top-0 h-screen overflow-y-auto" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
      <div class="mb-10">
        <div class="flex items-center mb-2">
          <i class="fas fa-mountain-sun text-3xl mr-3"></i>
          <h1 class="text-2xl font-bold">SIMAKSI</h1>
        </div>
        <p class="text-purple-200 text-sm">Admin Panel</p>
      </div>
      <nav class="space-y-2">
        <a href="/admin" class="block px-4 py-3 rounded-lg hover:bg-white hover:bg-opacity-10"><i class="fas fa-chart-line mr-3"></i>Dashboard</a>
        <a href="/admin/gunung" class="block px-4 py-3 rounded-lg bg-white bg-opacity-20 shadow-lg"><i class="fas fa-mountain mr-3"></i>Kelola Gunung</a>
        <a href="/admin/berita" class="block px-4 py-3 rounded-lg hover:bg-white hover:bg-opacity-10"><i class="fas fa-newspaper mr-3"></i>Kelola Berita</a>
        <a href="/admin/pendakian" class="block px-4 py-3 rounded-lg hover:bg-white hover:bg-opacity-10"><i class="fas fa-person-hiking mr-3"></i>Kelola Pendakian</a>
        <hr class="my-4 border-purple-400">
        <a href="/logout" class="block px-4 py-3 rounded-lg hover:bg-white hover:bg-opacity-10"><i class="fas fa-sign-out-alt mr-3"></i>Logout</a>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 p-8">
      <div class="max-w-4xl mx-auto">
        <div class="mb-8">
          <a href="/admin/gunung" class="text-purple-600 font-bold hover:underline mb-4 inline-block">
            <i class="fas fa-arrow-left mr-2"></i> Kembali ke Daftar
          </a>
          <h2 class="text-3xl font-bold text-gray-800">Edit Data Gunung</h2>
          <p class="text-gray-500">Perbarui informasi untuk <%= item.nama_gunung %></p>
        </div>

        <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
            <div class="bg-purple-600 p-6 text-white">
                <h3 class="text-xl font-bold flex items-center">
                    <i class="fas fa-edit mr-3"></i> Formulir Perubahan Data
                </h3>
            </div>
            <form action="/admin/gunung/update/<%= item.id %>" method="POST" class="p-8">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="md:col-span-2">
                        <label class="block text-sm font-bold text-gray-700 mb-2">Nama Gunung</label>
                        <input type="text" name="nama_gunung" value="<%= item.nama_gunung %>" required 
                            class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-100 rounded-xl focus:border-purple-500 outline-none transition font-semibold text-gray-700">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Lokasi</label>
                        <input type="text" name="lokasi" value="<%= item.lokasi %>" required 
                            class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-100 rounded-xl focus:border-purple-500 outline-none transition font-semibold text-gray-700">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Ketinggian (mdpl)</label>
                        <input type="number" name="ketinggian" value="<%= item.ketinggian %>" required 
                            class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-100 rounded-xl focus:border-purple-500 outline-none transition font-semibold text-gray-700">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Kuota Harian</label>
                        <input type="number" name="kuota_harian" value="<%= item.kuota_harian %>" required 
                            class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-100 rounded-xl focus:border-purple-500 outline-none transition font-semibold text-gray-700">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Status</label>
                        <select name="status" required 
                            class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-100 rounded-xl focus:border-purple-500 outline-none transition font-semibold text-gray-700 appearance-none cursor-pointer">
                            <option value="Buka" <%= item.status === 'Buka' ? 'selected' : '' %>>Buka</option>
                            <option value="Tutup" <%= item.status === 'Tutup' ? 'selected' : '' %>>Tutup</option>
                        </select>
                    </div>
                </div>
                <div class="mt-10 flex justify-end space-x-4">
                    <button type="submit" class="px-10 py-4 bg-purple-600 text-white font-black rounded-2xl hover:bg-purple-700 shadow-xl shadow-purple-100 transition transform hover:-translate-y-1">
                        <i class="fas fa-save mr-2"></i> SIMPAN PERUBAHAN
                    </button>
                </div>
            </form>
        </div>
      </div>
    </main>
  </div>
</body>
</html>