<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tambah Pintu Jalur - Admin SIMAKSI</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
      * { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
      .navbar-gradient { background: linear-gradient(135deg, #1e5631 0%, #2d7a3e 50%, #3a9f5d 100%); }
    </style>
</head>
<body class="bg-gray-50">
    <!-- Navbar -->
    <header class="navbar-gradient text-white shadow-lg sticky top-0 z-50">
        <div class="container mx-auto px-6 py-4 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <i class="fas fa-mountain text-3xl"></i>
                <h1 class="text-2xl font-bold">SIMAKSI Admin</h1>
            </div>
            <a href="/admin/pintu-jalur" class="hover:text-green-200 transition"><i class="fas fa-arrow-left mr-2"></i>Kembali</a>
        </div>
    </header>

    <main class="container mx-auto px-6 py-8">
        <!-- Alert Messages -->
        <% if (error && error.length > 0) { %>
            <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-6 flex items-center gap-3">
                <i class="fas fa-exclamation-circle text-red-600 text-xl"></i>
                <p class="text-red-800 font-semibold"><%= error[0] %></p>
            </div>
        <% } %>

        <!-- Form Card -->
        <div class="max-w-2xl mx-auto bg-white rounded-2xl shadow-lg overflow-hidden">
            <!-- Header -->
            <div class="bg-gradient-to-r from-green-600 to-green-700 text-white p-8">
                <h2 class="text-3xl font-bold mb-2">Tambah Pintu Jalur Baru</h2>
                <p class="text-green-100">Tambahkan pintu masuk atau pintu keluar untuk gunung</p>
            </div>

            <!-- Form -->
            <form method="post" action="/admin/pintu-jalur" class="p-8">
                <!-- Gunung Selection -->
                <div class="mb-8">
                    <label class="block text-gray-900 font-bold mb-3 text-lg">
                        <i class="fas fa-mountain text-green-600 mr-2"></i>Pilih Gunung
                    </label>
                    <select name="id_gunung" required class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:outline-none focus:border-green-500 text-gray-900">
                        <option value="">-- Pilih Gunung --</option>
                        <% gunung.forEach(g => { %>
                            <option value="<%= g.id %>"><%= g.nama_gunung %></option>
                        <% }) %>
                    </select>
                </div>

                <!-- Nama Pintu -->
                <div class="mb-8">
                    <label class="block text-gray-900 font-bold mb-3 text-lg">
                        <i class="fas fa-door-open text-green-600 mr-2"></i>Nama Pintu
                    </label>
                    <input type="text" name="nama_pintu" placeholder="Contoh: Pos Selo, Cibodas, etc" required 
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:outline-none focus:border-green-500 text-gray-900"
                           maxlength="100">
                </div>

                <!-- Lokasi -->
                <div class="mb-8">
                    <label class="block text-gray-900 font-bold mb-3 text-lg">
                        <i class="fas fa-map-marker-alt text-green-600 mr-2"></i>Lokasi
                    </label>
                    <input type="text" name="lokasi" placeholder="Contoh: Selo, Boyolali" required 
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:outline-none focus:border-green-500 text-gray-900"
                           maxlength="255">
                </div>

                <!-- Keterangan -->
                <div class="mb-8">
                    <label class="block text-gray-900 font-bold mb-3 text-lg">
                        <i class="fas fa-clipboard text-green-600 mr-2"></i>Keterangan (Opsional)
                    </label>
                    <textarea name="keterangan" placeholder="Deskripsi atau informasi tambahan tentang pintu jalur ini..."
                              class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:outline-none focus:border-green-500 text-gray-900 resize-none"
                              rows="4" maxlength="500"></textarea>
                    <p class="text-gray-500 text-sm mt-2">Maksimal 500 karakter</p>
                </div>

                <!-- Status -->
                <div class="mb-12">
                    <label class="block text-gray-900 font-bold mb-3 text-lg">
                        <i class="fas fa-toggle-on text-green-600 mr-2"></i>Status
                    </label>
                    <div class="flex gap-6">
                        <label class="flex items-center cursor-pointer">
                            <input type="radio" name="status" value="aktif" checked class="w-4 h-4 text-green-600">
                            <span class="ml-3 text-gray-700 font-semibold">Aktif</span>
                        </label>
                        <label class="flex items-center cursor-pointer">
                            <input type="radio" name="status" value="nonaktif" class="w-4 h-4 text-gray-600">
                            <span class="ml-3 text-gray-700 font-semibold">Nonaktif</span>
                        </label>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="flex gap-4">
                    <a href="/admin/pintu-jalur" class="flex-1 px-6 py-3 border-2 border-gray-300 rounded-xl font-bold text-gray-700 hover:bg-gray-50 transition text-center">
                        <i class="fas fa-times mr-2"></i>Batal
                    </a>
                    <button type="submit" class="flex-1 px-6 py-3 bg-green-600 text-white rounded-xl font-bold hover:bg-green-700 transition shadow-lg">
                        <i class="fas fa-save mr-2"></i>Simpan Pintu Jalur
                    </button>
                </div>
            </form>
        </div>
    </main>
</body>
</html>
