<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Pintu Jalur - Admin SIMAKSI</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
      * { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
      .navbar-gradient { background: linear-gradient(135deg, #1e5631 0%, #2d7a3e 50%, #3a9f5d 100%); }
    </style>
</head>
<body class="bg-gray-50">
    <!-- Navbar -->
    <header class="navbar-gradient text-white shadow-lg sticky top-0 z-50">
        <div class="container mx-auto px-6 py-4 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <i class="fas fa-mountain text-3xl"></i>
                <h1 class="text-2xl font-bold">SIMAKSI Admin</h1>
            </div>
            <a href="/admin/pintu-jalur" class="hover:text-green-200 transition"><i class="fas fa-arrow-left mr-2"></i>Kembali</a>
        </div>
    </header>

    <main class="container mx-auto px-6 py-8">
        <!-- Alert Messages -->
        <% if (error && error.length > 0) { %>
            <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-6 flex items-center gap-3">
                <i class="fas fa-exclamation-circle text-red-600 text-xl"></i>
                <p class="text-red-800 font-semibold"><%= error[0] %></p>
            </div>
        <% } %>

        <!-- Form Card -->
        <div class="max-w-2xl mx-auto bg-white rounded-2xl shadow-lg overflow-hidden">
            <!-- Header -->
            <div class="bg-gradient-to-r from-blue-600 to-blue-700 text-white p-8">
                <h2 class="text-3xl font-bold mb-2">Edit Pintu Jalur</h2>
                <p class="text-blue-100">Perbarui informasi pintu jalur</p>
            </div>

            <!-- Form -->
            <form method="post" action="/admin/pintu-jalur/update/<%= pintu.id %>" class="p-8">
                <!-- Gunung Selection -->
                <div class="mb-8">
                    <label class="block text-gray-900 font-bold mb-3 text-lg">
                        <i class="fas fa-mountain text-blue-600 mr-2"></i>Pilih Gunung
                    </label>
                    <select name="id_gunung" required class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none focus:border-blue-500 text-gray-900">
                        <option value="">-- Pilih Gunung --</option>
                        <% gunung.forEach(g => { %>
                            <option value="<%= g.id %>" <%= pintu.id_gunung === g.id ? 'selected' : '' %>>
                                <%= g.nama_gunung %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <!-- Nama Pintu -->
                <div class="mb-8">
                    <label class="block text-gray-900 font-bold mb-3 text-lg">
                        <i class="fas fa-door-open text-blue-600 mr-2"></i>Nama Pintu
                    </label>
                    <input type="text" name="nama_pintu" value="<%= pintu.nama_pintu %>" required 
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none focus:border-blue-500 text-gray-900"
                           maxlength="100">
                </div>

                <!-- Lokasi -->
                <div class="mb-8">
                    <label class="block text-gray-900 font-bold mb-3 text-lg">
                        <i class="fas fa-map-marker-alt text-blue-600 mr-2"></i>Lokasi
                    </label>
                    <input type="text" name="lokasi" value="<%= pintu.lokasi %>" required 
                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none focus:border-blue-500 text-gray-900"
                           maxlength="255">
                </div>

                <!-- Keterangan -->
                <div class="mb-8">
                    <label class="block text-gray-900 font-bold mb-3 text-lg">
                        <i class="fas fa-clipboard text-blue-600 mr-2"></i>Keterangan (Opsional)
                    </label>
                    <textarea name="keterangan"
                              class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none focus:border-blue-500 text-gray-900 resize-none"
                              rows="4" maxlength="500"><%= pintu.keterangan || '' %></textarea>
                    <p class="text-gray-500 text-sm mt-2">Maksimal 500 karakter</p>
                </div>

                <!-- Status -->
                <div class="mb-12">
                    <label class="block text-gray-900 font-bold mb-3 text-lg">
                        <i class="fas fa-toggle-on text-blue-600 mr-2"></i>Status
                    </label>
                    <div class="flex gap-6">
                        <label class="flex items-center cursor-pointer">
                            <input type="radio" name="status" value="aktif" <%= pintu.status === 'aktif' ? 'checked' : '' %> class="w-4 h-4 text-blue-600">
                            <span class="ml-3 text-gray-700 font-semibold">Aktif</span>
                        </label>
                        <label class="flex items-center cursor-pointer">
                            <input type="radio" name="status" value="nonaktif" <%= pintu.status === 'nonaktif' ? 'checked' : '' %> class="w-4 h-4 text-gray-600">
                            <span class="ml-3 text-gray-700 font-semibold">Nonaktif</span>
                        </label>
                    </div>
                </div>

                <!-- Info -->
                <div class="bg-blue-50 rounded-xl p-4 mb-8 border border-blue-200">
                    <p class="text-blue-800 text-sm">
                        <i class="fas fa-info-circle mr-2"></i>
                        Dibuat pada: <strong><%= new Date(pintu.created_at).toLocaleString('id-ID') %></strong>
                    </p>
                </div>

                <!-- Buttons -->
                <div class="flex gap-4">
                    <a href="/admin/pintu-jalur" class="flex-1 px-6 py-3 border-2 border-gray-300 rounded-xl font-bold text-gray-700 hover:bg-gray-50 transition text-center">
                        <i class="fas fa-times mr-2"></i>Batal
                    </a>
                    <button type="submit" class="flex-1 px-6 py-3 bg-blue-600 text-white rounded-xl font-bold hover:bg-blue-700 transition shadow-lg">
                        <i class="fas fa-save mr-2"></i>Update Pintu Jalur
                    </button>
                </div>
            </form>
        </div>
    </main>
</body>
</html>
