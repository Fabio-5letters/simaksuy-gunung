<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola Pintu Jalur - Admin SIMAKSI</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
      * { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
      .navbar-gradient { background: linear-gradient(135deg, #1e5631 0%, #2d7a3e 50%, #3a9f5d 100%); }
    </style>
</head>
<body class="bg-gray-50">
    <!-- Navbar -->
    <header class="navbar-gradient text-white shadow-lg sticky top-0 z-50">
        <div class="container mx-auto px-6 py-4 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <i class="fas fa-mountain text-3xl"></i>
                <h1 class="text-2xl font-bold">SIMAKSI Admin</h1>
            </div>
            <a href="/admin" class="hover:text-green-200 transition"><i class="fas fa-arrow-left mr-2"></i>Kembali</a>
        </div>
    </header>

    <main class="container mx-auto px-6 py-8">
        <!-- Alert Messages -->
        <% if (success && success.length > 0) { %>
            <div class="bg-green-50 border border-green-200 rounded-xl p-4 mb-6 flex items-center gap-3">
                <i class="fas fa-check-circle text-green-600 text-xl"></i>
                <div>
                    <p class="text-green-800 font-semibold"><%= success[0] %></p>
                </div>
            </div>
        <% } %>
        <% if (error && error.length > 0) { %>
            <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-6 flex items-center gap-3">
                <i class="fas fa-exclamation-circle text-red-600 text-xl"></i>
                <div>
                    <p class="text-red-800 font-semibold"><%= error[0] %></p>
                </div>
            </div>
        <% } %>

        <!-- Header -->
        <div class="flex justify-between items-center mb-8">
            <div>
                <h2 class="text-4xl font-bold text-gray-900 mb-2">Kelola Pintu Jalur</h2>
                <p class="text-gray-600">Kelola pintu masuk dan pintu keluar untuk setiap gunung</p>
            </div>
            <a href="/admin/pintu-jalur/tambah" class="bg-green-600 text-white px-6 py-3 rounded-xl font-semibold hover:bg-green-700 transition flex items-center gap-2 shadow-lg">
                <i class="fas fa-plus"></i>Tambah Pintu
            </a>
        </div>

        <!-- Filter -->
        <div class="bg-white rounded-xl shadow-md p-6 mb-8">
            <form method="get" action="/admin/pintu-jalur" class="flex gap-4">
                <div class="flex-1">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Filter Gunung:</label>
                    <select name="id_gunung" onchange="this.form.submit()" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:outline-none">
                        <option value="">Semua Gunung</option>
                        <% gunung.forEach(g => { %>
                            <option value="<%= g.id %>" <%= selectedGunung == g.id ? 'selected' : '' %>><%= g.nama_gunung %></option>
                        <% }) %>
                    </select>
                </div>
            </form>
        </div>

        <!-- Table -->
        <div class="bg-white rounded-xl shadow-md overflow-hidden">
            <% if (pintuJalur.length > 0) { %>
                <table class="w-full">
                    <thead>
                        <tr class="bg-gray-100 border-b">
                            <th class="px-6 py-4 text-left font-semibold text-gray-900">Gunung</th>
                            <th class="px-6 py-4 text-left font-semibold text-gray-900">Nama Pintu</th>
                            <th class="px-6 py-4 text-left font-semibold text-gray-900">Lokasi</th>
                            <th class="px-6 py-4 text-left font-semibold text-gray-900">Keterangan</th>
                            <th class="px-6 py-4 text-left font-semibold text-gray-900">Status</th>
                            <th class="px-6 py-4 text-center font-semibold text-gray-900">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% pintuJalur.forEach((pintu, idx) => { %>
                            <tr class="border-b hover:bg-gray-50 transition">
                                <td class="px-6 py-4">
                                    <span class="font-semibold text-gray-900"><%= pintu.nama_gunung %></span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-gray-700"><%= pintu.nama_pintu %></span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-gray-700"><%= pintu.lokasi %></span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-gray-600 text-sm"><%= pintu.keterangan ? pintu.keterangan.substring(0, 40) + '...' : '-' %></span>
                                </td>
                                <td class="px-6 py-4">
                                    <% if (pintu.status === 'aktif') { %>
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800">
                                            <i class="fas fa-check-circle mr-1"></i>Aktif
                                        </span>
                                    <% } else { %>
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-800">
                                            <i class="fas fa-times-circle mr-1"></i>Nonaktif
                                        </span>
                                    <% } %>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex justify-center gap-2">
                                        <a href="/admin/pintu-jalur/edit/<%= pintu.id %>" class="px-3 py-1 bg-blue-100 text-blue-700 rounded-lg hover:bg-blue-200 transition text-sm font-semibold">
                                            <i class="fas fa-edit mr-1"></i>Edit
                                        </a>
                                        <form method="post" action="/admin/pintu-jalur/delete/<%= pintu.id %>" style="display:inline;" onsubmit="return confirm('Yakin ingin menghapus?');">
                                            <button type="submit" class="px-3 py-1 bg-red-100 text-red-700 rounded-lg hover:bg-red-200 transition text-sm font-semibold">
                                                <i class="fas fa-trash mr-1"></i>Hapus
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>

                <div class="px-6 py-4 bg-gray-50 border-t">
                    <p class="text-sm text-gray-600">Total: <strong><%= pintuJalur.length %> pintu jalur</strong></p>
                </div>
            <% } else { %>
                <div class="text-center py-12">
                    <i class="fas fa-inbox text-5xl text-gray-300 mb-4"></i>
                    <p class="text-gray-500 font-semibold text-lg">Tidak ada data pintu jalur</p>
                    <a href="/admin/pintu-jalur/tambah" class="mt-4 inline-block bg-green-600 text-white px-6 py-2 rounded-lg font-semibold hover:bg-green-700 transition">
                        <i class="fas fa-plus mr-2"></i>Tambah Pintu Jalur
                    </a>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>
