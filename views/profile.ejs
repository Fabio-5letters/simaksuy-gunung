<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile Saya - SIMAKSI Gunung Merbabu</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
      * {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      }
      .navbar-gradient {
        background: linear-gradient(135deg, #1e5631 0%, #2d7a3e 50%, #3a9f5d 100%);
      }
      .profile-card {
        transition: all 0.3s ease;
      }
      .profile-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(30, 86, 49, 0.1);
      }
      .btn-primary {
        background: linear-gradient(135deg, #1e5631 0%, #3a9f5d 100%);
        transition: all 0.3s ease;
      }
      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(30, 86, 49, 0.3);
      }
      .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
      }
      .eye-toggle {
        position: absolute;
        right: 15px;
        cursor: pointer;
        color: #9ca3af;
        transition: color 0.3s ease;
        background: none;
        border: none;
        padding: 5px;
      }
      .eye-toggle:hover {
        color: #1e5631;
      }
    </style>
    <link rel="stylesheet" href="/css/style.css">
    <link href="/css/output.css" rel="stylesheet">
</head>
<body class="bg-gray-50 min-h-screen">
    <div class="flex flex-col min-h-screen">
        <!-- Navbar -->
        <header class="navbar-gradient text-white shadow-xl sticky top-0 z-50">
            <div class="container mx-auto flex justify-between items-center py-4 px-6">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center">
                        <i class="fas fa-mountain text-green-700 text-lg"></i>
                    </div>
                    <h1 class="text-2xl font-bold">SIMAKSI Gunung</h1>
                </div>
                <nav class="hidden md:block">
                    <ul class="flex space-x-8 font-semibold">
                        <li><a href="/" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-home"></i><span>Beranda</span></a></li>
                        <li><a href="/berita" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-newspaper"></i><span>Berita</span></a></li>
                        <li><a href="/pendakian" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-person-hiking"></i><span>Pendakian</span></a></li>
                        <li><a href="/cuaca" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-cloud-sun"></i><span>Cuaca</span></a></li>
                        <li><a href="/status" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-chart-line"></i><span>Status</span></a></li>
                        <li><a href="/panduan" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-download"></i><span>Panduan</span></a></li>
                        <li><a href="/kontak" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-envelope"></i><span>Kontak</span></a></li>
                    </ul>
                </nav>
                <div class="flex space-x-4">
                    <% if (user) { %>
                        <!-- User Profile Dropdown -->
                        <div class="relative">
                            <button id="profile-btn" class="flex items-center space-x-3 bg-white text-green-700 px-4 py-2 rounded-lg font-semibold hover:bg-green-50 transition">
                                <div class="w-8 h-8 bg-green-600 rounded-full flex items-center justify-center">
                                    <i class="fas fa-user text-white text-sm"></i>
                                </div>
                                <span><%= user.nama %></span>
                                <i class="fas fa-chevron-down text-sm"></i>
                            </button>
                            <div id="profile-dropdown" class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 hidden z-50">
                                <div class="py-2">
                                    <div class="px-4 py-2 border-b border-gray-100">
                                        <p class="text-sm font-medium text-gray-900"><%= user.nama %></p>
                                        <p class="text-xs text-gray-500"><%= user.email %></p>
                                    </div>
                                    <a href="/profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition">
                                        <i class="fas fa-user-circle mr-2"></i>Profile Saya
                                    </a>
                                    <a href="/riwayat" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition">
                                        <i class="fas fa-history mr-2"></i>Riwayat Pendakian
                                    </a>
                                    <div class="border-t border-gray-100"></div>
                                    <a href="/logout" class="block px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition">
                                        <i class="fas fa-sign-out-alt mr-2"></i>Logout
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% } else { %>
                        <a href="/login" class="bg-white text-green-700 px-6 py-2 rounded-lg font-semibold hover:bg-green-50 transition">Login</a>
                    <% } %>
                </div>
            </div>
        </header>

        <!-- Hero Section -->
        <section class="bg-gradient-to-r from-green-600 to-green-800 text-white py-16 px-6 shadow-lg">
            <div class="container mx-auto text-center">
                <h2 class="text-4xl md:text-5xl font-black mb-4">Profil Saya</h2>
                <p class="text-xl text-green-100 max-w-2xl mx-auto">Kelola informasi pribadi, keamanan akun, dan lihat ringkasan aktivitas pendakian Anda</p>
            </div>
        </section>

        <!-- Profile Content -->
        <section class="py-12 flex-grow">
            <div class="container mx-auto px-6">
                <div class="max-w-6xl mx-auto">
                    <!-- Flash Messages -->
                    <% if (locals.success && success.length > 0) { %>
                        <div class="mb-8 bg-green-50 border-l-4 border-green-500 text-green-700 px-8 py-4 rounded-r-2xl shadow-sm flex items-center">
                            <i class="fas fa-check-circle mr-4 text-2xl"></i>
                            <span class="font-black"><%= success[0] %></span>
                        </div>
                    <% } %>
                    <% if (locals.error && error.length > 0) { %>
                        <div class="mb-8 bg-red-50 border-l-4 border-red-500 text-red-700 px-8 py-4 rounded-r-2xl shadow-sm flex items-center">
                            <i class="fas fa-exclamation-circle mr-4 text-2xl"></i>
                            <span class="font-black"><%= error[0] %></span>
                        </div>
                    <% } %>

                    <!-- Profile Info Card -->
                    <div class="bg-white p-10 rounded-3xl shadow-xl mb-10 border border-gray-100 flex flex-col md:flex-row items-center gap-10">
                        <div class="w-32 h-32 bg-gradient-to-br from-green-500 to-emerald-700 rounded-3xl flex items-center justify-center shadow-2xl transform -rotate-3 hover:rotate-0 transition duration-500">
                            <i class="fas fa-user text-6xl text-white"></i>
                        </div>
                        <div class="text-center md:text-left">
                            <h2 class="text-4xl font-black text-gray-900 mb-2"><%= user.nama %></h2>
                            <p class="text-gray-500 text-lg font-medium"><%= user.email %></p>
                            <div class="mt-4 flex flex-wrap justify-center md:justify-start gap-3">
                                <span class="px-4 py-1.5 bg-green-100 text-green-700 rounded-full text-xs font-black uppercase tracking-widest border border-green-200">
                                    <i class="fas fa-user-check mr-2"></i>Member Aktif
                                </span>
                                <span class="px-4 py-1.5 bg-blue-100 text-blue-700 rounded-full text-xs font-black uppercase tracking-widest border border-blue-200">
                                    <i class="fas fa-calendar-alt mr-2"></i>Sejak <%= new Date(user.created_at || Date.now()).toLocaleDateString('id-ID', { month: 'long', year: 'numeric' }) %>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
                        <!-- Personal Information Form -->
                        <div class="lg:col-span-2 space-y-10">
                            <div class="bg-white p-10 rounded-3xl shadow-xl border border-gray-100">
                                <h3 class="text-2xl font-black text-gray-900 mb-8 flex items-center">
                                    <i class="fas fa-id-card text-green-600 mr-4"></i>Edit Informasi Profil
                                </h3>
                                <form action="/profile/update" method="POST" class="space-y-6">
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                        <div>
                                            <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-2">Nama Lengkap</label>
                                            <input type="text" name="nama" value="<%= user.nama %>" class="w-full px-6 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:outline-none focus:ring-2 focus:ring-green-500 focus:bg-white transition font-bold" required>
                                        </div>
                                        <div>
                                            <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-2">Alamat Email</label>
                                            <input type="email" name="email" value="<%= user.email %>" class="w-full px-6 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:outline-none focus:ring-2 focus:ring-green-500 focus:bg-white transition font-bold" required>
                                        </div>
                                    </div>
                                    <button type="submit" class="bg-green-600 text-white px-10 py-4 rounded-2xl hover:bg-green-700 transition font-black shadow-lg shadow-green-100">
                                        <i class="fas fa-save mr-2"></i>Simpan Perubahan
                                    </button>
                                </form>
                            </div>

                            <div class="bg-white p-10 rounded-3xl shadow-xl border border-gray-100">
                                <h3 class="text-2xl font-black text-gray-900 mb-8 flex items-center">
                                    <i class="fas fa-shield-alt text-blue-600 mr-4"></i>Keamanan Akun
                                </h3>
                                <form action="/profile/change-password" method="POST" class="space-y-6">
                                    <div>
                                        <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-2">Password Saat Ini</label>
                                        <div class="input-wrapper">
                                            <input type="password" id="password_lama" name="password_lama" class="w-full px-6 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition font-bold" required>
                                            <button type="button" class="eye-toggle" onclick="toggleVisibility('password_lama', 'eye-lama')">
                                                <i class="fas fa-eye-slash" id="eye-lama"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                        <div>
                                            <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-2">Password Baru</label>
                                            <div class="input-wrapper">
                                                <input type="password" id="password_baru" name="password_baru" class="w-full px-6 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition font-bold" required>
                                                <button type="button" class="eye-toggle" onclick="toggleVisibility('password_baru', 'eye-baru')">
                                                    <i class="fas fa-eye-slash" id="eye-baru"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <div>
                                            <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-2">Konfirmasi Password</label>
                                            <div class="input-wrapper">
                                                <input type="password" id="konfirmasi_password" name="konfirmasi_password" class="w-full px-6 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition font-bold" required>
                                                <button type="button" class="eye-toggle" onclick="toggleVisibility('konfirmasi_password', 'eye-konfirmasi')">
                                                    <i class="fas fa-eye-slash" id="eye-konfirmasi"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <button type="submit" class="bg-blue-600 text-white px-10 py-4 rounded-2xl hover:bg-blue-700 transition font-black shadow-lg shadow-blue-100">
                                        <i class="fas fa-key mr-2"></i>Update Password
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Sidebar Stats & Actions -->
                        <div class="space-y-10">
                            <div class="bg-white p-8 rounded-3xl shadow-xl border border-gray-100">
                                <h3 class="text-xl font-black text-gray-900 mb-6 flex items-center">
                                    <i class="fas fa-chart-pie text-purple-600 mr-3"></i>Ringkasan Aktivitas
                                </h3>
                                <div class="grid grid-cols-2 gap-4">
                                    <div class="bg-green-50 p-5 rounded-2xl border border-green-100 text-center">
                                        <p class="text-2xl font-black text-green-700"><%= stats.total || 0 %></p>
                                        <p class="text-[10px] text-green-600 font-bold uppercase tracking-widest">Pendaftaran</p>
                                    </div>
                                    <div class="bg-blue-50 p-5 rounded-2xl border border-blue-100 text-center">
                                        <p class="text-2xl font-black text-blue-700"><%= stats.diverifikasi || 0 %></p>
                                        <p class="text-[10px] text-blue-600 font-bold uppercase tracking-widest">Disetujui</p>
                                    </div>
                                    <div class="bg-amber-50 p-5 rounded-2xl border border-amber-100 text-center">
                                        <p class="text-2xl font-black text-amber-700"><%= stats.pending || 0 %></p>
                                        <p class="text-[10px] text-amber-600 font-bold uppercase tracking-widest">Pending</p>
                                    </div>
                                    <div class="bg-red-50 p-5 rounded-2xl border border-red-100 text-center">
                                        <p class="text-2xl font-black text-red-700"><%= stats.ditolak || 0 %></p>
                                        <p class="text-[10px] text-red-600 font-bold uppercase tracking-widest">Ditolak</p>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-white p-8 rounded-3xl shadow-xl border border-gray-100">
                                <h3 class="text-xl font-black text-gray-900 mb-6">Aksi Cepat</h3>
                                <div class="space-y-4">
                                    <a href="/riwayat" class="flex items-center p-4 bg-gray-50 rounded-2xl border border-gray-100 hover:bg-green-50 hover:border-green-200 transition group">
                                        <div class="w-12 h-12 bg-white rounded-xl shadow-sm flex items-center justify-center mr-4 group-hover:scale-110 transition">
                                            <i class="fas fa-history text-green-600"></i>
                                        </div>
                                        <div>
                                            <p class="font-black text-gray-900 leading-tight">Riwayat</p>
                                            <p class="text-xs text-gray-400 font-medium">Lihat aktivitas Anda</p>
                                        </div>
                                    </a>
                                    <a href="/pendakian" class="flex items-center p-4 bg-gray-50 rounded-2xl border border-gray-100 hover:bg-blue-50 hover:border-blue-200 transition group">
                                        <div class="w-12 h-12 bg-white rounded-xl shadow-sm flex items-center justify-center mr-4 group-hover:scale-110 transition">
                                            <i class="fas fa-plus-circle text-blue-600"></i>
                                        </div>
                                        <div>
                                            <p class="font-black text-gray-900 leading-tight">Daftar</p>
                                            <p class="text-xs text-gray-400 font-medium">Mulai pendakian baru</p>
                                        </div>
                                    </a>
                                    <a href="/logout" class="flex items-center p-4 bg-gray-50 rounded-2xl border border-gray-100 hover:bg-red-50 hover:border-red-200 transition group">
                                        <div class="w-12 h-12 bg-white rounded-xl shadow-sm flex items-center justify-center mr-4 group-hover:scale-110 transition">
                                            <i class="fas fa-sign-out-alt text-red-600"></i>
                                        </div>
                                        <div>
                                            <p class="font-black text-gray-900 leading-tight text-red-600">Logout</p>
                                            <p class="text-xs text-gray-400 font-medium">Keluar dari akun</p>
                                        </div>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer class="navbar-gradient text-white py-12">
            <div class="container mx-auto px-6">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
                    <div>
                        <h4 class="text-lg font-bold mb-4 flex items-center"><i class="fas fa-mountain mr-2"></i>SIMAKSI</h4>
                        <p class="text-green-100 text-sm">Platform terpercaya untuk mendaftar pendakian gunung di Indonesia</p>
                    </div>
                    <div>
                        <h4 class="text-lg font-bold mb-4">Navigasi</h4>
                        <ul class="space-y-2 text-green-100 text-sm">
                            <li><a href="/" class="hover:text-white transition">Beranda</a></li>
                            <li><a href="/berita" class="hover:text-white transition">Berita</a></li>
                            <li><a href="/pendakian" class="hover:text-white transition">Pendakian</a></li>
                            <li><a href="/kontak" class="hover:text-white transition">Kontak</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="text-lg font-bold mb-4">Bantuan</h4>
                        <ul class="space-y-2 text-green-100 text-sm">
                            <li><a href="/faq" class="hover:text-white transition">FAQ</a></li>
                            <li><a href="/panduan" class="hover:text-white transition">Panduan Pendakian</a></li>
                            <li><a href="/keselamatan" class="hover:text-white transition">Keselamatan</a></li>
                            <li><a href="/syarat-ketentuan" class="hover:text-white transition">Syarat & Ketentuan</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="text-lg font-bold mb-4">Hubungi Kami</h4>
                        <ul class="space-y-2 text-green-100 text-sm">
                            <li class="flex items-center"><i class="fas fa-phone mr-2"></i>+62 274 515 912</li>
                            <li class="flex items-center"><i class="fas fa-envelope mr-2"></i>info@simaksi.com</li>
                            <li class="flex items-center"><i class="fas fa-map-marker-alt mr-2"></i>Semarang, Indonesia</li>
                        </ul>
                    </div>
                </div>
                <div class="border-t border-green-700 pt-8 text-center text-green-100 text-sm">
                    <p>&copy; 2026 SIMAKSI - Sistem Informasi Manajemen Pendakian Gunung. All rights reserved.</p>
                </div>
            </div>
        </footer>
    </div>

    <!-- Script -->
    <script>
        // Profile dropdown
        const profileBtn = document.getElementById('profile-btn');
        const profileDropdown = document.getElementById('profile-dropdown');

        if (profileBtn && profileDropdown) {
            profileBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                profileDropdown.classList.toggle('hidden');
            });

            document.addEventListener('click', function(e) {
                if (!profileBtn.contains(e.target) && !profileDropdown.contains(e.target)) {
                    profileDropdown.classList.add('hidden');
                }
            });

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    profileDropdown.classList.add('hidden');
                }
            });
        }

        // Password visibility toggle
        function toggleVisibility(inputId, eyeId) {
            const input = document.getElementById(inputId);
            const eye = document.getElementById(eyeId);
            
            if (input.type === 'password') {
                input.type = 'text';
                eye.classList.remove('fa-eye-slash');
                eye.classList.add('fa-eye');
            } else {
                input.type = 'password';
                eye.classList.remove('fa-eye');
                eye.classList.add('fa-eye-slash');
            }
        }
    </script>
</body>
</html>