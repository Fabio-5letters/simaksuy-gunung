<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= gunung.nama_gunung %> - SIMAKSI Gunung Merbabu</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
      * {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      }
      .navbar-gradient {
        background: linear-gradient(135deg, #1e5631 0%, #2d7a3e 50%, #3a9f5d 100%);
      }
      .hero-section {
        background: linear-gradient(rgba(30, 86, 49, 0.7), rgba(30, 86, 49, 0.7)), url('<%= gunung.gambar || 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1920&h=1080&fit=crop' %>');
        background-size: cover;
        background-position: center;
      }
      .btn-primary {
        background: linear-gradient(135deg, #1e5631 0%, #3a9f5d 100%);
        transition: all 0.3s ease;
      }
      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(30, 86, 49, 0.3);
      }
      .info-card {
        transition: all 0.3s ease;
      }
      .info-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(30, 86, 49, 0.1);
      }
    </style>
    <link rel="stylesheet" href="/css/style.css">
    <link href="/css/output.css" rel="stylesheet">
</head>
<body class="bg-gray-50 flex flex-col min-h-screen">
    <div class="flex-grow">
        <!-- Navbar -->
        <header class="navbar-gradient text-white shadow-xl sticky top-0 z-50">
            <div class="container mx-auto flex justify-between items-center py-4 px-6">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center">
                        <i class="fas fa-mountain text-green-700 text-lg"></i>
                    </div>
                    <h1 class="text-2xl font-bold">SIMAKSI Gunung</h1>
                </div>
                <nav class="hidden md:block">
                    <ul class="flex space-x-8 font-semibold">
                        <li><a href="/" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-home"></i><span>Beranda</span></a></li>
                        <li><a href="/berita" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-newspaper"></i><span>Berita</span></a></li>
                        <li><a href="/pendakian" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-person-hiking"></i><span>Pendakian</span></a></li>
                        <li><a href="/cuaca" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-cloud-sun"></i><span>Cuaca</span></a></li>
                        <li><a href="/status" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-chart-line"></i><span>Status</span></a></li>
                        <li><a href="/panduan" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-download"></i><span>Panduan</span></a></li>
                        <li><a href="/kontak" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-envelope"></i><span>Kontak</span></a></li>
                    </ul>
                </nav>
                <div class="flex space-x-4">
                    <% if (user) { %>
                        <div class="relative">
                            <button id="profile-btn" class="flex items-center space-x-3 bg-white text-green-700 px-4 py-2 rounded-lg font-semibold hover:bg-green-50 transition">
                                <div class="w-8 h-8 bg-green-600 rounded-full flex items-center justify-center text-white text-sm">
                                    <i class="fas fa-user"></i>
                                </div>
                                <span><%= user.nama %></span>
                                <i class="fas fa-chevron-down text-sm"></i>
                            </button>
                            <div id="profile-dropdown" class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 hidden z-50">
                                <div class="py-2">
                                    <div class="px-4 py-2 border-b border-gray-100">
                                        <p class="text-sm font-medium text-gray-900"><%= user.nama %></p>
                                        <p class="text-xs text-gray-500"><%= user.email %></p>
                                    </div>
                                    <a href="/profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition">
                                        <i class="fas fa-user-circle mr-2"></i>Profile Saya
                                    </a>
                                    <a href="/riwayat" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition">
                                        <i class="fas fa-history mr-2"></i>Riwayat Pendakian
                                    </a>
                                    <div class="border-t border-gray-100"></div>
                                    <a href="/logout" class="block px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition">
                                        <i class="fas fa-sign-out-alt mr-2"></i>Logout
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% } else { %>
                        <a href="/login" class="bg-white text-green-700 px-6 py-2 rounded-lg font-semibold hover:bg-green-50 transition">Login</a>
                    <% } %>
                </div>
            </div>
        </header>

        <!-- Hero Section -->
        <section class="hero-section text-white py-32 px-6">
            <div class="container mx-auto text-center">
                <span class="px-4 py-1.5 bg-white bg-opacity-20 backdrop-blur-md text-white rounded-full text-xs font-black uppercase tracking-widest border border-white border-opacity-30 mb-6 inline-block">
                    Destinasi Pendakian
                </span>
                <h1 class="text-5xl md:text-7xl font-black mb-6 drop-shadow-2xl uppercase tracking-tighter"><%= gunung.nama_gunung %></h1>
                <div class="flex flex-wrap items-center justify-center gap-6 text-lg font-bold">
                    <span class="flex items-center drop-shadow-lg"><i class="fas fa-map-marker-alt mr-2 text-green-400"></i><%= gunung.lokasi %></span>
                    <span class="flex items-center drop-shadow-lg"><i class="fas fa-arrow-up mr-2 text-green-400"></i><%= gunung.ketinggian %> mdpl</span>
                    <span class="px-6 py-2 bg-green-500 rounded-full shadow-xl"><%= gunung.status %></span>
                </div>
            </div>
        </section>

        <!-- Content -->
        <section class="py-20 bg-white">
            <div class="container mx-auto px-6">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">
                    <!-- Main Content -->
                    <div class="lg:col-span-2">
                        <div class="mb-16">
                            <h2 class="text-3xl font-black text-gray-900 mb-8 flex items-center">
                                <i class="fas fa-info-circle text-green-600 mr-4 text-4xl"></i>Tentang <%= gunung.nama_gunung %>
                            </h2>
                            <% if (gunung.deskripsi) { %>
                                <div class="prose prose-xl max-w-none text-gray-600 leading-relaxed font-medium">
                                    <p class="whitespace-pre-line"><%= gunung.deskripsi %></p>
                                </div>
                            <% } else { %>
                                <div class="bg-gray-50 p-8 rounded-3xl border-2 border-dashed border-gray-200 text-center">
                                    <p class="text-gray-400 italic">Deskripsi lengkap untuk gunung ini sedang dalam tahap penyusunan oleh tim admin.</p>
                                </div>
                            <% } %>
                        </div>

                        <% if (berita && berita.length > 0) { %>
                        <div class="mb-16">
                            <h2 class="text-3xl font-black text-gray-900 mb-8 flex items-center">
                                <i class="fas fa-newspaper text-green-600 mr-4 text-4xl"></i>Berita Terkait
                            </h2>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                                <% berita.forEach(item => { %>
                                    <div class="info-card bg-gray-50 rounded-3xl p-8 border border-gray-100 shadow-sm">
                                        <div class="flex items-center text-xs font-black text-green-600 uppercase tracking-widest mb-4">
                                            <i class="far fa-calendar-alt mr-2"></i><%= item.tanggal %>
                                        </div>
                                        <h3 class="text-xl font-black text-gray-900 mb-4 leading-tight"><%= item.judul %></h3>
                                        <p class="text-gray-500 text-sm mb-6 line-clamp-3"><%= item.isi_berita %></p>
                                        <a href="/berita/<%= item.id %>" class="inline-flex items-center text-green-600 font-black text-xs uppercase tracking-widest hover:text-green-800 transition group">
                                            Baca Selengkapnya <i class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform"></i>
                                        </a>
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                        <% } %>
                    </div>

                    <!-- Sidebar -->
                    <div class="lg:col-span-1">
                        <div class="sticky top-28 space-y-8">
                            <!-- Quick Info Card -->
                            <div class="bg-gradient-to-br from-green-600 to-emerald-800 text-white rounded-[2.5rem] p-10 shadow-2xl shadow-green-100">
                                <h3 class="text-2xl font-black mb-8 border-b border-white border-opacity-20 pb-4">Statistik Jalur</h3>
                                <div class="space-y-6 mb-10">
                                    <div class="flex items-center justify-between">
                                        <span class="text-green-100 font-bold">Ketinggian</span>
                                        <span class="text-xl font-black"><%= gunung.ketinggian %>m</span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-green-100 font-bold">Kuota Harian</span>
                                        <span class="text-xl font-black"><%= gunung.kuota_harian %></span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-green-100 font-bold">Tingkat Kesulitan</span>
                                        <span class="text-xl font-black">Menengah</span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-green-100 font-bold">Status</span>
                                        <span class="px-4 py-1 bg-white text-green-800 rounded-full text-xs font-black uppercase"><%= gunung.status %></span>
                                    </div>
                                </div>

                                <% if (gunung.status === 'Buka') { %>
                                    <% if (user) { %>
                                        <a href="/daftar/<%= gunung.id %>" class="block w-full bg-white text-green-700 font-black py-5 rounded-2xl hover:bg-green-50 transition text-center shadow-xl text-lg uppercase tracking-widest">
                                            Daftar Sekarang
                                        </a>
                                    <% } else { %>
                                        <a href="/login" class="block w-full bg-white text-green-700 font-black py-5 rounded-2xl hover:bg-green-50 transition text-center shadow-xl text-lg uppercase tracking-widest">
                                            Login untuk Daftar
                                        </a>
                                    <% } %>
                                <% } else { %>
                                    <div class="w-full bg-red-500 bg-opacity-30 border border-white border-opacity-30 text-white font-black py-5 rounded-2xl text-center uppercase tracking-widest">
                                        Jalur Ditutup
                                    </div>
                                <% } %>
                            </div>

                            <!-- Tips Card -->
                            <div class="bg-white p-8 rounded-[2rem] border border-gray-100 shadow-xl">
                                <h4 class="text-lg font-black text-gray-900 mb-6 flex items-center">
                                    <i class="fas fa-lightbulb text-yellow-500 mr-3"></i>Tips Pendakian
                                </h4>
                                <ul class="space-y-4">
                                    <li class="flex items-start text-sm text-gray-500 font-medium">
                                        <i class="fas fa-check-circle text-green-500 mt-1 mr-3 flex-shrink-0"></i>
                                        Siapkan fisik minimal 2 minggu sebelumnya.
                                    </li>
                                    <li class="flex items-start text-sm text-gray-500 font-medium">
                                        <i class="fas fa-check-circle text-green-500 mt-1 mr-3 flex-shrink-0"></i>
                                        Bawa perlengkapan safety standard pendakian.
                                    </li>
                                    <li class="flex items-start text-sm text-gray-500 font-medium">
                                        <i class="fas fa-check-circle text-green-500 mt-1 mr-3 flex-shrink-0"></i>
                                        Patuhi peraturan Leave No Trace (Bawa sampah turun).
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <!-- Footer -->
    <footer class="navbar-gradient text-white py-12">
        <div class="container mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
                <div>
                    <h4 class="text-lg font-bold mb-4 flex items-center"><i class="fas fa-mountain mr-2"></i>SIMAKSI</h4>
                    <p class="text-green-100 text-sm">Platform terpercaya untuk mendaftar pendakian gunung di Indonesia</p>
                </div>
                <div>
                    <h4 class="text-lg font-bold mb-4">Navigasi</h4>
                    <ul class="space-y-2 text-green-100 text-sm">
                        <li><a href="/" class="hover:text-white transition">Beranda</a></li>
                        <li><a href="/berita" class="hover:text-white transition">Berita</a></li>
                        <li><a href="/pendakian" class="hover:text-white transition">Pendakian</a></li>
                        <li><a href="/kontak" class="hover:text-white transition">Kontak</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-lg font-bold mb-4">Bantuan</h4>
                    <ul class="space-y-2 text-green-100 text-sm">
                        <li><a href="/faq" class="hover:text-white transition">FAQ</a></li>
                        <li><a href="/panduan" class="hover:text-white transition">Panduan Pendakian</a></li>
                        <li><a href="/keselamatan" class="hover:text-white transition">Keselamatan</a></li>
                        <li><a href="/syarat-ketentuan" class="hover:text-white transition">Syarat & Ketentuan</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-lg font-bold mb-4">Hubungi Kami</h4>
                    <ul class="space-y-2 text-green-100 text-sm">
                        <li class="flex items-center"><i class="fas fa-phone mr-2"></i>+62 274 515 912</li>
                        <li class="flex items-center"><i class="fas fa-envelope mr-2"></i>info@simaksi.com</li>
                        <li class="flex items-center"><i class="fas fa-map-marker-alt mr-2"></i>Jakarta, Indonesia</li>
                    </ul>
                </div>
            </div>
            <div class="border-t border-green-700 pt-8 text-center text-green-100 text-sm">
                <p>&copy; 2026 SIMAKSI - Sistem Informasi Manajemen Pendakian Gunung. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Script -->
    <script>
        const profileBtn = document.getElementById('profile-btn');
        const profileDropdown = document.getElementById('profile-dropdown');

        if (profileBtn && profileDropdown) {
            profileBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                profileDropdown.classList.toggle('hidden');
            });

            document.addEventListener('click', function(e) {
                if (!profileBtn.contains(e.target) && !profileDropdown.contains(e.target)) {
                    profileDropdown.classList.add('hidden');
                }
            });

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    profileDropdown.classList.add('hidden');
                }
            });
        }
    </script>
</body>
</html>