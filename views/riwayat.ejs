<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Riwayat Pendakian - SIMAKSI Gunung Merbabu</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
      * {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      }
      .navbar-gradient {
        background: linear-gradient(135deg, #1e5631 0%, #2d7a3e 50%, #3a9f5d 100%);
      }
      .card-hover {
        transition: all 0.3s ease;
      }
      .card-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(30, 86, 49, 0.1);
      }
      .status-badge {
        padding: 6px 14px;
        border-radius: 12px;
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        display: inline-flex;
        align-items: center;
      }
      .status-pending {
        background-color: #fef3c7;
        color: #d97706;
        border: 1px solid #fde68a;
      }
      .status-approved {
        background-color: #d1fae5;
        color: #065f46;
        border: 1px solid #a7f3d0;
      }
      .status-rejected {
        background-color: #fee2e2;
        color: #dc2626;
        border: 1px solid #fecaca;
      }
      .status-completed {
        background-color: #dbeafe;
        color: #1e40af;
        border: 1px solid #bfdbfe;
      }
    </style>
    <link rel="stylesheet" href="/css/style.css">
    <link href="/css/output.css" rel="stylesheet">
</head>
<body class="bg-gray-50 min-h-screen">
    <div class="flex flex-col min-h-screen">
        <!-- Navbar -->
        <header class="navbar-gradient text-white shadow-xl sticky top-0 z-50">
            <div class="container mx-auto flex justify-between items-center py-4 px-6">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center">
                        <i class="fas fa-mountain text-green-700 text-lg"></i>
                    </div>
                    <h1 class="text-2xl font-bold">SIMAKSI Gunung</h1>
                </div>
                <nav class="hidden md:block">
                    <ul class="flex space-x-8 font-semibold">
                        <li><a href="/" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-home"></i><span>Beranda</span></a></li>
                        <li><a href="/berita" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-newspaper"></i><span>Berita</span></a></li>
                        <li><a href="/pendakian" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-person-hiking"></i><span>Pendakian</span></a></li>
                        <li><a href="/cuaca" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-cloud-sun"></i><span>Cuaca</span></a></li>
                        <li><a href="/status" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-chart-line"></i><span>Status</span></a></li>
                        <li><a href="/panduan" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-download"></i><span>Panduan</span></a></li>
                        <li><a href="/kontak" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-envelope"></i><span>Kontak</span></a></li>
                    </ul>
                </nav>
                <div class="flex space-x-4">
                    <% if (user) { %>
                        <!-- User Profile Dropdown -->
                        <div class="relative">
                            <button id="profile-btn" class="flex items-center space-x-3 bg-white text-green-700 px-4 py-2 rounded-lg font-semibold hover:bg-green-50 transition">
                                <div class="w-8 h-8 bg-green-600 rounded-full flex items-center justify-center">
                                    <i class="fas fa-user text-white text-sm"></i>
                                </div>
                                <span><%= user.nama %></span>
                                <i class="fas fa-chevron-down text-sm"></i>
                            </button>
                            <div id="profile-dropdown" class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 hidden z-50">
                                <div class="py-2">
                                    <div class="px-4 py-2 border-b border-gray-100">
                                        <p class="text-sm font-medium text-gray-900"><%= user.nama %></p>
                                        <p class="text-xs text-gray-500"><%= user.email %></p>
                                    </div>
                                    <a href="/profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition">
                                        <i class="fas fa-user-circle mr-2"></i>Profile Saya
                                    </a>
                                    <a href="/riwayat" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition">
                                        <i class="fas fa-history mr-2"></i>Riwayat Pendakian
                                    </a>
                                    <div class="border-t border-gray-100"></div>
                                    <a href="/logout" class="block px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition">
                                        <i class="fas fa-sign-out-alt mr-2"></i>Logout
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% } else { %>
                        <a href="/login" class="bg-white text-green-700 px-6 py-2 rounded-lg font-semibold hover:bg-green-50 transition">Login</a>
                    <% } %>
                </div>
            </div>
        </header>

        <!-- Hero Section -->
        <section class="bg-gradient-to-r from-green-600 to-green-800 text-white py-16 px-6 shadow-lg">
            <div class="container mx-auto text-center">
                <h2 class="text-4xl md:text-5xl font-black mb-4">Riwayat Pendakian</h2>
                <p class="text-xl text-green-100 max-w-2xl mx-auto">Pantau status, kode booking, dan e-tiket dari seluruh pendaftaran pendakian Anda</p>
            </div>
        </section>

        <!-- Riwayat Content -->
        <section class="py-12 flex-grow">
            <div class="container mx-auto px-6">
                <div class="max-w-6xl mx-auto">
                    <% if (simaksi && simaksi.length > 0) { %>
                        <!-- Search Bar -->
                        <div class="mb-10">
                            <form action="/riwayat" method="GET" class="flex flex-col sm:flex-row gap-3">
                                <div class="flex-1 relative">
                                    <i class="fas fa-search absolute left-5 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                                    <input 
                                        type="text" 
                                        name="search" 
                                        value="<%= search || '' %>" 
                                        placeholder="Cari gunung atau kode booking..." 
                                        class="w-full pl-14 pr-6 py-4 bg-white border border-gray-200 rounded-2xl shadow-sm focus:outline-none focus:ring-2 focus:ring-green-500 transition font-medium">
                                </div>
                                <button type="submit" class="bg-green-600 text-white px-10 py-4 rounded-2xl hover:bg-green-700 transition font-black shadow-lg shadow-green-200 flex items-center justify-center">
                                    <i class="fas fa-search mr-2"></i>Cari
                                </button>
                                <% if (search) { %>
                                    <a href="/riwayat" class="bg-gray-200 text-gray-600 px-6 py-4 rounded-2xl hover:bg-gray-300 transition font-bold flex items-center justify-center">
                                        <i class="fas fa-times mr-2"></i>Reset
                                    </a>
                                <% } %>
                            </form>
                        </div>

                        <!-- Statistics Cards -->
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-12">
                            <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition card-hover">
                                <div class="flex items-center justify-between mb-2">
                                    <div class="w-10 h-10 bg-amber-100 text-amber-600 rounded-xl flex items-center justify-center">
                                        <i class="fas fa-clock"></i>
                                    </div>
                                    <span class="text-2xl font-black text-gray-900"><%= simaksi.filter(s => s.status_pengajuan === 'Pending' || s.status === 'pending' || s.status === 'dibayar').length %></span>
                                </div>
                                <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest">Pending</p>
                            </div>

                            <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition card-hover">
                                <div class="flex items-center justify-between mb-2">
                                    <div class="w-10 h-10 bg-green-100 text-green-600 rounded-xl flex items-center justify-center">
                                        <i class="fas fa-check-circle"></i>
                                    </div>
                                    <span class="text-2xl font-black text-gray-900"><%= simaksi.filter(s => s.status_pengajuan === 'Disetujui' || s.status === 'diverifikasi').length %></span>
                                </div>
                                <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest">Disetujui</p>
                            </div>

                            <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition card-hover">
                                <div class="flex items-center justify-between mb-2">
                                    <div class="w-10 h-10 bg-blue-100 text-blue-600 rounded-xl flex items-center justify-center">
                                        <i class="fas fa-flag-checkered"></i>
                                    </div>
                                    <span class="text-2xl font-black text-gray-900">0</span>
                                </div>
                                <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest">Selesai</p>
                            </div>

                            <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition card-hover">
                                <div class="flex items-center justify-between mb-2">
                                    <div class="w-10 h-10 bg-red-100 text-red-600 rounded-xl flex items-center justify-center">
                                        <i class="fas fa-times-circle"></i>
                                    </div>
                                    <span class="text-2xl font-black text-gray-900"><%= simaksi.filter(s => s.status_pengajuan === 'Ditolak' || s.status === 'ditolak').length %></span>
                                </div>
                                <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest">Ditolak</p>
                            </div>
                        </div>

                        <!-- Riwayat Table -->
                        <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-gray-100">
                            <div class="px-8 py-6 bg-gray-50 border-b border-gray-100 flex justify-between items-center">
                                <h3 class="text-xl font-black text-gray-900">Daftar Pendaftaran</h3>
                                <p class="text-sm font-bold text-gray-500 uppercase tracking-widest">Total: <%= total %></p>
                            </div>
                            <div class="overflow-x-auto">
                                <table class="w-full">
                                    <thead>
                                        <tr class="bg-gray-50 text-left">
                                            <th class="px-8 py-5 text-xs font-black text-gray-400 uppercase tracking-widest">Gunung</th>
                                            <th class="px-8 py-5 text-xs font-black text-gray-400 uppercase tracking-widest">Tanggal</th>
                                            <th class="px-8 py-5 text-xs font-black text-gray-400 uppercase tracking-widest">Anggota</th>
                                            <th class="px-8 py-5 text-xs font-black text-gray-400 uppercase tracking-widest">Status</th>
                                            <th class="px-8 py-5 text-xs font-black text-gray-400 uppercase tracking-widest">Kode Booking</th>
                                            <th class="px-8 py-5 text-xs font-black text-gray-400 uppercase tracking-widest">Aksi</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-100">
                                        <% simaksi.forEach(item => { %>
                                            <tr class="hover:bg-green-50 hover:bg-opacity-30 transition duration-300">
                                                <td class="px-8 py-6">
                                                    <div class="flex items-center">
                                                        <div class="w-12 h-12 bg-green-100 text-green-600 rounded-2xl flex items-center justify-center mr-4 shadow-sm">
                                                            <i class="fas fa-mountain text-lg"></i>
                                                        </div>
                                                        <div>
                                                            <div class="text-base font-black text-gray-900"><%= item.nama_gunung %></div>
                                                            <div class="text-xs text-gray-400 font-bold uppercase"><%= item.lokasi || 'Jawa Tengah' %></div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="px-8 py-6">
                                                    <div class="text-sm font-bold text-gray-800">
                                                        <%= new Date(item.tanggal_pendakian || item.tanggal_masuk).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                                    </div>
                                                </td>
                                                <td class="px-8 py-6">
                                                    <div class="text-sm font-bold text-gray-800">
                                                        <i class="fas fa-users mr-1 text-gray-400"></i> <%= item.jumlah_anggota %> Orang
                                                    </div>
                                                </td>
                                                <td class="px-8 py-6">
                                                    <%
                                                    let status = item.status_pengajuan || item.status;
                                                    let statusLabel = '';
                                                    let statusClass = '';
                                                    let statusIcon = '';

                                                    if (status === 'Pending' || status === 'pending') {
                                                      statusLabel = 'Pending';
                                                      statusClass = 'status-pending';
                                                      statusIcon = 'fa-spinner fa-spin';
                                                    } else if (status === 'Disetujui' || status === 'diverifikasi') {
                                                      statusLabel = 'Disetujui';
                                                      statusClass = 'status-approved';
                                                      statusIcon = 'fa-check-circle';
                                                    } else if (status === 'Ditolak' || status === 'ditolak') {
                                                      statusLabel = 'Ditolak';
                                                      statusClass = 'status-rejected';
                                                      statusIcon = 'fa-times-circle';
                                                    } else if (status === 'dibayar') {
                                                      statusLabel = 'Verifikasi';
                                                      statusClass = 'status-pending';
                                                      statusIcon = 'fa-clock';
                                                    }
                                                    %>
                                                    <span class="status-badge <%= statusClass %>">
                                                        <i class="fas <%= statusIcon %> mr-2"></i><%= statusLabel %>
                                                    </span>
                                                </td>
                                                <td class="px-8 py-6">
                                                    <% if (item.kode_booking) { %>
                                                        <div class="text-sm font-mono font-black text-green-700 bg-green-50 px-3 py-1 rounded-lg border border-green-100 inline-block">
                                                            <%= item.kode_booking %>
                                                        </div>
                                                    <% } else { %>
                                                        <span class="text-sm text-gray-300 font-bold">BELUM TERSEDIA</span>
                                                    <% } %>
                                                </td>
                                                <td class="px-8 py-6">
                                                    <div class="flex space-x-3">
                                                        <% if (item.status_pengajuan === 'Disetujui' || item.status === 'diverifikasi') { %>
                                                            <a href="/download-etiket/<%= item.kode_booking || item.id %>" class="bg-green-600 text-white px-4 py-2 rounded-xl text-xs font-black hover:bg-green-700 transition shadow-lg shadow-green-100 flex items-center">
                                                                <i class="fas fa-download mr-1.5"></i>E-TIKET
                                                            </a>
                                                        <% } else if (item.status_pengajuan === 'Pending' || item.status === 'pending' || item.status === 'dibayar') { %>
                                                            <a href="/status-pemesanan/<%= item.kode_booking %>" class="bg-blue-600 text-white px-4 py-2 rounded-xl text-xs font-black hover:bg-blue-700 transition shadow-lg shadow-blue-100 flex items-center">
                                                                <i class="fas fa-eye mr-1.5"></i>DETAIL
                                                            </a>
                                                        <% } else { %>
                                                            <span class="text-gray-300 text-xs font-black uppercase tracking-widest">NO ACTION</span>
                                                        <% } %>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Pagination -->
                        <% if (totalPages > 1) { %>
                            <div class="mt-12 flex justify-center">
                                <nav class="flex items-center space-x-3">
                                    <% if (currentPage > 1) { %>
                                        <a href="?page=<%= currentPage - 1 %>&search=<%= search || '' %>" 
                                           class="w-12 h-12 flex items-center justify-center bg-white border border-gray-200 rounded-2xl hover:border-green-500 hover:text-green-600 transition shadow-sm">
                                            <i class="fas fa-chevron-left"></i>
                                        </a>
                                    <% } %>

                                    <% for (let i = 1; i <= totalPages; i++) { %>
                                        <% if (i === currentPage) { %>
                                            <span class="w-12 h-12 flex items-center justify-center bg-green-600 text-white rounded-2xl font-black shadow-lg shadow-green-200">
                                                <%= i %>
                                            </span>
                                        <% } else if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) { %>
                                            <a href="?page=<%= i %>&search=<%= search || '' %>" 
                                               class="w-12 h-12 flex items-center justify-center bg-white border border-gray-200 rounded-2xl hover:border-green-500 hover:text-green-600 transition shadow-sm font-bold">
                                                <%= i %>
                                            </a>
                                        <% } else if (i === currentPage - 2 || i === currentPage + 2) { %>
                                            <span class="px-2 text-gray-400 font-bold">...</span>
                                        <% } %>
                                    <% } %>

                                    <% if (currentPage < totalPages) { %>
                                        <a href="?page=<%= currentPage + 1 %>&search=<%= search || '' %>" 
                                           class="w-12 h-12 flex items-center justify-center bg-white border border-gray-200 rounded-2xl hover:border-green-500 hover:text-green-600 transition shadow-sm">
                                            <i class="fas fa-chevron-right"></i>
                                        </a>
                                    <% } %>
                                </nav>
                            </div>
                        <% } %>
                    <% } else { %>
                        <!-- Empty State -->
                        <div class="text-center py-24 bg-white rounded-3xl shadow-xl border border-gray-100">
                            <div class="w-24 h-24 bg-gray-50 rounded-3xl flex items-center justify-center mx-auto mb-8 shadow-inner">
                                <i class="fas fa-mountain text-5xl text-gray-200"></i>
                            </div>
                            <h3 class="text-3xl font-black text-gray-900 mb-4">
                                <% if (search) { %>
                                    Hasil tidak ditemukan
                                <% } else { %>
                                    Belum ada riwayat
                                <% } %>
                            </h3>
                            <p class="text-gray-500 mb-10 max-w-sm mx-auto font-medium">
                                <% if (search) { %>
                                    Coba kata kunci lain atau periksa kembali ejaan Anda untuk menemukan pendaftaran.
                                <% } else { %>
                                    Anda belum pernah mendaftar pendakian. Mulai petualangan pertama Anda bersama kami!
                                <% } %>
                            </p>
                            <a href="/pendakian" class="inline-flex items-center px-10 py-4 bg-green-600 text-white font-black rounded-2xl hover:bg-green-700 transition shadow-xl shadow-green-100">
                                <i class="fas fa-plus-circle mr-3 text-xl"></i>Daftar Sekarang
                            </a>
                        </div>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer class="navbar-gradient text-white py-12">
            <div class="container mx-auto px-6">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
                    <div>
                        <h4 class="text-lg font-bold mb-4 flex items-center"><i class="fas fa-mountain mr-2"></i>SIMAKSI</h4>
                        <p class="text-green-100 text-sm">Platform terpercaya untuk mendaftar pendakian gunung di Indonesia</p>
                    </div>
                    <div>
                        <h4 class="text-lg font-bold mb-4">Navigasi</h4>
                        <ul class="space-y-2 text-green-100 text-sm">
                            <li><a href="/" class="hover:text-white transition">Beranda</a></li>
                            <li><a href="/berita" class="hover:text-white transition">Berita</a></li>
                            <li><a href="/pendakian" class="hover:text-white transition">Pendakian</a></li>
                            <li><a href="/kontak" class="hover:text-white transition">Kontak</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="text-lg font-bold mb-4">Bantuan</h4>
                        <ul class="space-y-2 text-green-100 text-sm">
                            <li><a href="/faq" class="hover:text-white transition">FAQ</a></li>
                            <li><a href="/panduan" class="hover:text-white transition">Panduan Pendakian</a></li>
                            <li><a href="/keselamatan" class="hover:text-white transition">Keselamatan</a></li>
                            <li><a href="/syarat-ketentuan" class="hover:text-white transition">Syarat & Ketentuan</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="text-lg font-bold mb-4">Hubungi Kami</h4>
                        <ul class="space-y-2 text-green-100 text-sm">
                            <li class="flex items-center"><i class="fas fa-phone mr-2"></i>+62 274 515 912</li>
                            <li class="flex items-center"><i class="fas fa-envelope mr-2"></i>info@simaksi.com</li>
                            <li class="flex items-center"><i class="fas fa-map-marker-alt mr-2"></i>Semarang, Indonesia</li>
                        </ul>
                    </div>
                </div>
                <div class="border-t border-green-700 pt-8 text-center text-green-100 text-sm">
                    <p>&copy; 2026 SIMAKSI - Sistem Informasi Manajemen Pendakian Gunung. All rights reserved.</p>
                </div>
            </div>
        </footer>
    </div>

    <!-- Profile Dropdown Script -->
    <script>
        const profileBtn = document.getElementById('profile-btn');
        const profileDropdown = document.getElementById('profile-dropdown');

        if (profileBtn && profileDropdown) {
            profileBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                profileDropdown.classList.toggle('hidden');
            });

            document.addEventListener('click', function(e) {
                if (!profileBtn.contains(e.target) && !profileDropdown.contains(e.target)) {
                    profileDropdown.classList.add('hidden');
                }
            });

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    profileDropdown.classList.add('hidden');
                }
            });
        }
    </script>
</body>
</html>