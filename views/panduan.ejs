<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lihat Panduan - SIMAKSI Gunung Merbabu</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
      * {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      }
      .navbar-gradient {
        background: linear-gradient(135deg, #1e5631 0%, #2d7a3e 50%, #3a9f5d 100%);
      }
      .hero-section {
        background: linear-gradient(rgba(30, 86, 49, 0.7), rgba(30, 86, 49, 0.7)), url('https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1920&h=1080&fit=crop');
        background-size: cover;
        background-position: center;
      }
      .card-hover {
        transition: all 0.3s ease;
      }
      .card-hover:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(30, 86, 49, 0.15);
      }
      .btn-cta {
        background: linear-gradient(135deg, #1e5631 0%, #3a9f5d 100%);
        transition: all 0.3s ease;
      }
      .btn-cta:hover {
        transform: scale(1.05);
        box-shadow: 0 10px 25px rgba(30, 86, 49, 0.3);
      }
      .panduan-card {
        background: white;
        border: 1px solid #e5e7eb;
      }
    </style>
    <link rel="stylesheet" href="/css/style.css">
    <link href="/css/output.css" rel="stylesheet">
</head>
<body class="bg-white">
    <div class="min-h-screen">
        <!-- Navbar -->
        <header class="navbar-gradient text-white shadow-xl sticky top-0 z-50">
            <div class="container mx-auto flex justify-between items-center py-4 px-6">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center">
                        <i class="fas fa-mountain text-green-700 text-lg"></i>
                    </div>
                    <h1 class="text-2xl font-bold">SIMAKSI Gunung</h1>
                </div>
                <nav class="hidden md:block">
                    <ul class="flex space-x-8 font-semibold">
                        <li><a href="/" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-home"></i><span>Beranda</span></a></li>
                        <li><a href="/berita" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-newspaper"></i><span>Berita</span></a></li>
                        <li><a href="/pendakian" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-person-hiking"></i><span>Pendakian</span></a></li>
                        <li><a href="/cuaca" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-cloud-sun"></i><span>Cuaca</span></a></li>
                        <li><a href="/status" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-chart-line"></i><span>Status</span></a></li>
                        <li><a href="/panduan" class="text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-book"></i><span>Panduan</span></a></li>
                        <li><a href="/kontak" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-envelope"></i><span>Kontak</span></a></li>
                    </ul>
                </nav>
                <div class="flex space-x-4">
                    <% if (user) { %>
                        <!-- User Profile Dropdown -->
                        <div class="relative">
                            <button id="profile-btn" class="flex items-center space-x-3 bg-white text-green-700 px-4 py-2 rounded-lg font-semibold hover:bg-green-50 transition">
                                <div class="w-8 h-8 bg-green-600 rounded-full flex items-center justify-center">
                                    <i class="fas fa-user text-white text-sm"></i>
                                </div>
                                <span><%= user.nama %></span>
                                <i class="fas fa-chevron-down text-sm"></i>
                            </button>
                            <div id="profile-dropdown" class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 hidden z-50">
                                <div class="py-2">
                                    <div class="px-4 py-2 border-b border-gray-100">
                                        <p class="text-sm font-medium text-gray-900"><%= user.nama %></p>
                                        <p class="text-xs text-gray-500"><%= user.email %></p>
                                    </div>
                                    <a href="/profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition">
                                        <i class="fas fa-user-circle mr-2"></i>Profile Saya
                                    </a>
                                    <a href="/riwayat" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition">
                                        <i class="fas fa-history mr-2"></i>Riwayat Pendakian
                                    </a>
                                    <div class="border-t border-gray-100"></div>
                                    <a href="/logout" class="block px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition">
                                        <i class="fas fa-sign-out-alt mr-2"></i>Logout
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% } else { %>
                        <a href="/login" class="bg-white text-green-700 px-6 py-2 rounded-lg font-semibold hover:bg-green-50 transition">Login</a>
                    <% } %>
                </div>
            </div>
        </header>

        <!-- Hero Section -->
        <section class="bg-white py-16 px-6 overflow-hidden">
            <div class="container mx-auto flex flex-col md:flex-row items-center justify-between">
                <div class="md:w-1/2 text-left">
                    <h2 class="text-5xl md:text-6xl font-black text-gray-900 mb-6 tracking-tight">Lihat Panduan</h2>
                    <p class="text-xl text-gray-600 mb-8 leading-relaxed">Akses informasi lengkap dan detail untuk mempersiapkan pendakian yang aman, terorganisir, dan berkesan di Gunung Merbabu.</p>
                </div>
                <div class="md:w-1/2 flex justify-center mt-10 md:mt-0">
                    <div class="relative w-72 h-72 lg:w-96 lg:h-96">
                        <img src="https://cdni.iconscout.com/illustration/premium/thumb/man-hiking-in-mountain-4573352-3796839.png" alt="Hero Illustration" class="w-full h-full object-contain">
                    </div>
                </div>
            </div>
        </section>

        <!-- Panduan Section -->
        <section class="py-10 bg-gray-50">
            <div class="container mx-auto px-6">
                <div class="mb-12">
                    <h3 class="text-3xl font-bold text-gray-900">Panduan Tersedia</h3>
                    <p class="text-gray-500 mt-2">Pilih panduan yang ingin Anda pelajari lebih lanjut</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <!-- Panduan Keselamatan -->
                    <div class="card-hover bg-white rounded-2xl overflow-hidden shadow-lg border border-gray-100 p-8">
                        <div class="text-center mb-6">
                            <div class="w-20 h-20 bg-green-100 text-green-700 rounded-full flex items-center justify-center mx-auto mb-4">
                                <i class="fas fa-shield-alt text-4xl"></i>
                            </div>
                            <h4 class="text-2xl font-bold mb-2 text-gray-900">Panduan Keselamatan</h4>
                            <p class="text-gray-500 text-sm">Protokol keselamatan dan prosedur darurat</p>
                        </div>

                        <div class="space-y-4 mb-8">
                            <div class="flex items-center text-gray-700">
                                <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                <span class="text-sm">Prosedur evakuasi darurat</span>
                            </div>
                            <div class="flex items-center text-gray-700">
                                <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                <span class="text-sm">Pertolongan pertama</span>
                            </div>
                            <div class="flex items-center text-gray-700">
                                <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                <span class="text-sm">Persiapan fisik dan mental</span>
                            </div>
                        </div>

                        <div class="text-center space-y-3">
                            <a href="/panduan/keselamatan" class="btn-cta text-white px-6 py-3 rounded-lg font-semibold inline-block w-full">
                                <i class="fas fa-info-circle mr-2"></i>Lihat Panduan
                            </a>
                            <button class="install-panduan-btn w-full bg-white border-2 border-green-600 text-green-600 px-6 py-3 rounded-lg font-semibold hover:bg-green-50 transition" data-file="panduan-keselamatan.pdf">
                                <i class="fas fa-download mr-2"></i>Install Panduan
                            </button>
                        </div>
                    </div>

                    <!-- Panduan Teknis -->
                    <div class="card-hover bg-white rounded-2xl overflow-hidden shadow-lg border border-gray-100 p-8">
                        <div class="text-center mb-6">
                            <div class="w-20 h-20 bg-green-100 text-green-700 rounded-full flex items-center justify-center mx-auto mb-4">
                                <i class="fas fa-cogs text-4xl"></i>
                            </div>
                            <h4 class="text-2xl font-bold mb-2 text-gray-900">Panduan Teknis</h4>
                            <p class="text-gray-500 text-sm">Teknik pendakian dan navigasi</p>
                        </div>

                        <div class="space-y-4 mb-8">
                            <div class="flex items-center text-gray-700">
                                <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                <span class="text-sm">Teknik pendakian dasar</span>
                            </div>
                            <div class="flex items-center text-gray-700">
                                <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                <span class="text-sm">Penggunaan peta dan kompas</span>
                            </div>
                            <div class="flex items-center text-gray-700">
                                <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                <span class="text-sm">Setup tenda dan bivak</span>
                            </div>
                        </div>

                        <div class="text-center space-y-3">
                            <a href="/panduan/teknis" class="btn-cta text-white px-6 py-3 rounded-lg font-semibold inline-block w-full">
                                <i class="fas fa-info-circle mr-2"></i>Lihat Panduan
                            </a>
                            <button class="install-panduan-btn w-full bg-white border-2 border-green-600 text-green-600 px-6 py-3 rounded-lg font-semibold hover:bg-green-50 transition" data-file="panduan-teknis.pdf">
                                <i class="fas fa-download mr-2"></i>Install Panduan
                            </button>
                        </div>
                    </div>

                    <!-- Panduan Peralatan -->
                    <div class="card-hover bg-white rounded-2xl overflow-hidden shadow-lg border border-gray-100 p-8">
                        <div class="text-center mb-6">
                            <div class="w-20 h-20 bg-green-100 text-green-700 rounded-full flex items-center justify-center mx-auto mb-4">
                                <i class="fas fa-hiking text-4xl"></i>
                            </div>
                            <h4 class="text-2xl font-bold mb-2 text-gray-900">Panduan Peralatan</h4>
                            <p class="text-gray-500 text-sm">Daftar peralatan dan checklist</p>
                        </div>

                        <div class="space-y-4 mb-8">
                            <div class="flex items-center text-gray-700">
                                <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                <span class="text-sm">Peralatan wajib dan opsional</span>
                            </div>
                            <div class="flex items-center text-gray-700">
                                <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                <span class="text-sm">Checklist persiapan</span>
                            </div>
                            <div class="flex items-center text-gray-700">
                                <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                <span class="text-sm">Perawatan peralatan</span>
                            </div>
                        </div>

                        <div class="text-center space-y-3">
                            <a href="/panduan/peralatan" class="btn-cta text-white px-6 py-3 rounded-lg font-semibold inline-block w-full">
                                <i class="fas fa-info-circle mr-2"></i>Lihat Panduan
                            </a>
                            <button class="install-panduan-btn w-full bg-white border-2 border-green-600 text-green-600 px-6 py-3 rounded-lg font-semibold hover:bg-green-50 transition" data-file="panduan-peralatan.pdf">
                                <i class="fas fa-download mr-2"></i>Install Panduan
                            </button>
                        </div>
                    </div>

                    <!-- Panduan Fisik -->
                    <div class="card-hover bg-white rounded-2xl overflow-hidden shadow-lg border border-gray-100 p-8">
                        <div class="text-center mb-6">
                            <div class="w-20 h-20 bg-green-100 text-green-700 rounded-full flex items-center justify-center mx-auto mb-4">
                                <i class="fas fa-dumbbell text-4xl"></i>
                            </div>
                            <h4 class="text-2xl font-bold mb-2 text-gray-900">Panduan Fisik</h4>
                            <p class="text-gray-500 text-sm">Persiapan kondisi fisik</p>
                        </div>

                        <div class="space-y-4 mb-8">
                            <div class="flex items-center text-gray-700">
                                <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                <span class="text-sm">Program latihan fisik</span>
                            </div>
                            <div class="flex items-center text-gray-700">
                                <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                <span class="text-sm">Nutrisi dan hidrasi</span>
                            </div>
                            <div class="flex items-center text-gray-700">
                                <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                <span class="text-sm">Adaptasi ketinggian</span>
                            </div>
                        </div>

                        <div class="text-center space-y-3">
                            <a href="/panduan/fisik" class="btn-cta text-white px-6 py-3 rounded-lg font-semibold inline-block w-full">
                                <i class="fas fa-info-circle mr-2"></i>Lihat Panduan
                            </a>
                            <button class="install-panduan-btn w-full bg-white border-2 border-green-600 text-green-600 px-6 py-3 rounded-lg font-semibold hover:bg-green-50 transition" data-file="panduan-fisik.pdf">
                                <i class="fas fa-download mr-2"></i>Install Panduan
                            </button>
                        </div>
                    </div>

                    <!-- Panduan Medis -->
                    <div class="card-hover bg-white rounded-2xl overflow-hidden shadow-lg border border-gray-100 p-8">
                        <div class="text-center mb-6">
                            <div class="w-20 h-20 bg-green-100 text-green-700 rounded-full flex items-center justify-center mx-auto mb-4">
                                <i class="fas fa-medkit text-4xl"></i>
                            </div>
                            <h4 class="text-2xl font-bold mb-2 text-gray-900">Panduan Medis</h4>
                            <p class="text-gray-500 text-sm">Kesehatan dan pertolongan pertama</p>
                        </div>

                        <div class="space-y-4 mb-8">
                            <div class="flex items-center text-gray-700">
                                <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                <span class="text-sm">Obat-obatan wajib</span>
                            </div>
                            <div class="flex items-center text-gray-700">
                                <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                <span class="text-sm">Penanganan hipotermia</span>
                            </div>
                            <div class="flex items-center text-gray-700">
                                <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                <span class="text-sm">Penyakit ketinggian</span>
                            </div>
                        </div>

                        <div class="text-center space-y-3">
                            <a href="/panduan/medis" class="btn-cta text-white px-6 py-3 rounded-lg font-semibold inline-block w-full">
                                <i class="fas fa-info-circle mr-2"></i>Lihat Panduan
                            </a>
                            <button class="install-panduan-btn w-full bg-white border-2 border-green-600 text-green-600 px-6 py-3 rounded-lg font-semibold hover:bg-green-50 transition" data-file="panduan-medis.pdf">
                                <i class="fas fa-download mr-2"></i>Install Panduan
                            </button>
                        </div>
                    </div>

                    <!-- Panduan Etika -->
                    <div class="card-hover bg-white rounded-2xl overflow-hidden shadow-lg border border-gray-100 p-8">
                        <div class="text-center mb-6">
                            <div class="w-20 h-20 bg-green-100 text-green-700 rounded-full flex items-center justify-center mx-auto mb-4">
                                <i class="fas fa-leaf text-4xl"></i>
                            </div>
                            <h4 class="text-2xl font-bold mb-2 text-gray-900">Panduan Etika</h4>
                            <p class="text-gray-500 text-sm">Etika pendakian dan pelestarian alam</p>
                        </div>

                        <div class="space-y-4 mb-8">
                            <div class="flex items-center text-gray-700">
                                <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                <span class="text-sm">Leave No Trace</span>
                            </div>
                            <div class="flex items-center text-gray-700">
                                <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                <span class="text-sm">Pelestarian lingkungan</span>
                            </div>
                            <div class="flex items-center text-gray-700">
                                <i class="fas fa-check-circle text-green-500 mr-3"></i>
                                <span class="text-sm">Etika berpendakian</span>
                            </div>
                        </div>

                        <div class="text-center space-y-3">
                            <a href="/panduan/etika" class="btn-cta text-white px-6 py-3 rounded-lg font-semibold inline-block w-full">
                                <i class="fas fa-info-circle mr-2"></i>Lihat Panduan
                            </a>
                            <button class="install-panduan-btn w-full bg-white border-2 border-green-600 text-green-600 px-6 py-3 rounded-lg font-semibold hover:bg-green-50 transition" data-file="panduan-etika.pdf">
                                <i class="fas fa-download mr-2"></i>Install Panduan
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Information Section -->
                <div class="mt-20 bg-gradient-to-r from-green-50 to-emerald-50 rounded-3xl p-10 shadow-inner">
                    <h4 class="text-3xl font-bold text-center text-green-900 mb-8">
                        <i class="fas fa-info-circle text-green-600 mr-2"></i>Informasi Panduan
                    </h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div class="bg-white rounded-2xl p-8 shadow-sm">
                            <div class="flex items-start">
                                <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center mr-4 flex-shrink-0">
                                    <i class="fas fa-eye text-red-600 text-xl"></i>
                                </div>
                                <div>
                                    <h5 class="text-xl font-bold text-gray-900 mb-2">Akses Cepat</h5>
                                    <p class="text-gray-600">Semua panduan dapat dibuka dan dibaca langsung melalui browser Anda tanpa perlu mengunduh file tambahan.</p>
                                </div>
                            </div>
                        </div>
                        <div class="bg-white rounded-2xl p-8 shadow-sm">
                            <div class="flex items-start">
                                <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mr-4 flex-shrink-0">
                                    <i class="fas fa-clock text-blue-600 text-xl"></i>
                                </div>
                                <div>
                                    <h5 class="text-xl font-bold text-gray-900 mb-2">Update Berkala</h5>
                                    <p class="text-gray-600">Panduan diperbaharui secara berkala sesuai dengan perkembangan standar keselamatan dan regulasi terbaru.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer class="navbar-gradient text-white py-12">
            <div class="container mx-auto px-6">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
                    <div>
                        <h4 class="text-lg font-bold mb-4 flex items-center"><i class="fas fa-mountain mr-2"></i>SIMAKSI</h4>
                        <p class="text-green-100 text-sm">Platform terpercaya untuk mendaftar pendakian gunung di Indonesia</p>
                    </div>
                    <div>
                        <h4 class="text-lg font-bold mb-4">Navigasi</h4>
                        <ul class="space-y-2 text-green-100 text-sm">
                            <li><a href="/" class="hover:text-white transition">Beranda</a></li>
                            <li><a href="/berita" class="hover:text-white transition">Berita</a></li>
                            <li><a href="/pendakian" class="hover:text-white transition">Pendakian</a></li>
                            <li><a href="/kontak" class="hover:text-white transition">Kontak</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="text-lg font-bold mb-4">Bantuan</h4>
                        <ul class="space-y-2 text-green-100 text-sm">
                            <li><a href="/faq" class="hover:text-white transition">FAQ</a></li>
                            <li><a href="/panduan" class="hover:text-white transition">Panduan Pendakian</a></li>
                            <li><a href="/keselamatan" class="hover:text-white transition">Keselamatan</a></li>
                            <li><a href="/syarat-ketentuan" class="hover:text-white transition">Syarat & Ketentuan</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="text-lg font-bold mb-4">Hubungi Kami</h4>
                        <ul class="space-y-2 text-green-100 text-sm">
                            <li class="flex items-center"><i class="fas fa-phone mr-2"></i>+62 274 515 912</li>
                            <li class="flex items-center"><i class="fas fa-envelope mr-2"></i>info@simaksi.com</li>
                            <li class="flex items-center"><i class="fas fa-map-marker-alt mr-2"></i>Jakarta, Indonesia</li>
                        </ul>
                    </div>
                </div>
                <div class="border-t border-green-700 pt-8 text-center text-green-100 text-sm">
                    <p>&copy; 2026 SIMAKSI - Sistem Informasi Manajemen Pendakian Gunung. All rights reserved.</p>
                </div>
            </div>
        </footer>
    </div>

    <!-- Modal Structure -->
    <div id="guide-modal" class="fixed inset-0 z-[60] flex items-center justify-center p-4 bg-black bg-opacity-50 hidden">
        <div class="bg-white rounded-3xl w-full max-w-2xl overflow-hidden shadow-2xl transform transition-all">
            <div class="navbar-gradient p-6 text-white flex justify-between items-center">
                <h3 id="modal-title" class="text-2xl font-bold flex items-center">
                    <i class="fas fa-book-open mr-3"></i>
                    <span></span>
                </h3>
                <button id="close-header-btn" class="text-white hover:text-green-200 transition">
                    <i class="fas fa-times text-2xl"></i>
                </button>
            </div>
            <div id="modal-content" class="p-8 max-h-[70vh] overflow-y-auto">
                <!-- Content injected here -->
            </div>
            <div class="p-6 bg-gray-50 border-t flex justify-between gap-4">
                <button id="download-pdf-btn" class="bg-blue-600 text-white px-6 py-2 rounded-lg font-semibold hover:bg-blue-700 transition flex items-center">
                    <i class="fas fa-download mr-2"></i>Download PDF
                </button>
                <button id="close-modal-btn" class="bg-green-700 text-white px-6 py-2 rounded-lg font-semibold hover:bg-green-800 transition">
                    Tutup
                </button>
            </div>
        </div>
    </div>

    <!-- Success Toast Notification -->
    <div id="success-toast" class="fixed bottom-6 right-6 z-50 hidden transform transition-all">
        <div class="bg-green-600 text-white px-6 py-4 rounded-lg shadow-lg flex items-center space-x-3">
            <i class="fas fa-check-circle text-xl"></i>
            <span id="toast-message">Berhasil!</span>
        </div>
    </div>

    <!-- Scripts -->
    <script>
        // Profile dropdown
        const profileBtn = document.getElementById('profile-btn');
        const profileDropdown = document.getElementById('profile-dropdown');
        if (profileBtn && profileDropdown) {
            profileBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                profileDropdown.classList.toggle('hidden');
            });
            document.addEventListener('click', () => profileDropdown.classList.add('hidden'));
        }

        // Guide Data
        const guides = {
            'panduan-keselamatan.pdf': {
                title: 'Panduan Keselamatan Lengkap',
                content: `
                    <div class="space-y-6">
                        <section>
                            <h5 class="font-bold text-green-800 text-lg border-b-2 border-green-200 pb-2 mb-3">1. Persiapan Sebelum Berangkat</h5>
                            <ul class="list-disc ml-5 text-gray-700 space-y-2">
                                <li><strong>Registrasi Resmi:</strong> Selalu daftar melalui sistem SIMAKSI resmi.</li>
                                <li><strong>Rencana Perjalanan:</strong> Tinggalkan salinan rencana perjalanan kepada keluarga.</li>
                                <li><strong>Cek Status Jalur:</strong> Pastikan jalur tidak sedang ditutup.</li>
                            </ul>
                        </section>
                        <section>
                            <h5 class="font-bold text-green-800 text-lg border-b-2 border-green-200 pb-2 mb-3">2. Selama di Jalur</h5>
                            <ul class="list-disc ml-5 text-gray-700 space-y-2">
                                <li><strong>Tetap di Jalur:</strong> Jangan memotong jalur.</li>
                                <li><strong>Manajemen Waktu:</strong> Mulailah sepagi mungkin.</li>
                            </ul>
                        </section>
                        <section>
                            <h5 class="font-bold text-green-800 text-lg border-b-2 border-green-200 pb-2 mb-3">3. Prosedur Darurat (S.T.O.P)</h5>
                            <div class="bg-red-50 p-4 rounded-xl border-l-4 border-red-500 text-red-800">
                                <strong>Sit down, Think, Observe, Plan.</strong> Tenang dan jangan panik.
                            </div>
                        </section>
                    </div>
                `
            },
            'panduan-teknis.pdf': {
                title: 'Panduan Teknis & Navigasi',
                content: `
                    <div class="space-y-6">
                        <section>
                            <h5 class="font-bold text-green-800 text-lg border-b-2 border-green-200 pb-2 mb-3">1. Teknik Berjalan</h5>
                            <ul class="list-disc ml-5 text-gray-700 space-y-2">
                                <li><strong>Langkah Pendek:</strong> Hemat energi dengan langkah konsisten.</li>
                                <li><strong>Rest Step:</strong> Teknik mengistirahatkan satu kaki secara bergantian.</li>
                            </ul>
                        </section>
                        <section>
                            <h5 class="font-bold text-green-800 text-lg border-b-2 border-green-200 pb-2 mb-3">2. Navigasi Dasar</h5>
                            <ul class="list-disc ml-5 text-gray-700 space-y-2">
                                <li><strong>Tanda Jalur:</strong> Kenali pita warna atau tumpukan batu.</li>
                                <li><strong>Kompas:</strong> Selalu bawa kompas fisik sebagai cadangan.</li>
                            </ul>
                        </section>
                    </div>
                `
            },
            'panduan-peralatan.pdf': {
                title: 'Daftar Peralatan & Packing',
                content: `
                    <div class="space-y-6">
                        <div class="grid grid-cols-2 gap-4">
                            <div class="bg-green-50 p-4 rounded-xl text-sm">
                                <h6 class="font-bold mb-2 underline">Kelompok</h6>
                                <ul><li>- Tenda</li><li>- Alat masak</li><li>- Bahan bakar</li></ul>
                            </div>
                            <div class="bg-blue-50 p-4 rounded-xl text-sm">
                                <h6 class="font-bold mb-2 underline">Pribadi</h6>
                                <ul><li>- Carrier</li><li>- Sleeping Bag</li><li>- Matras</li></ul>
                            </div>
                        </div>
                        <section>
                            <h5 class="font-bold text-green-800 text-lg border-b-2 border-green-200 pb-2 mb-3">Tips Packing</h5>
                            <p class="text-sm">Berat terberat letakkan di tengah dekat punggung.</p>
                        </section>
                    </div>
                `
            },
            'panduan-fisik.pdf': {
                title: 'Persiapan Fisik & Nutrisi',
                content: `
                    <div class="space-y-6">
                        <section>
                            <h5 class="font-bold text-green-800 text-lg border-b-2 border-green-200 pb-2 mb-3">1. Latihan Fisik</h5>
                            <ul class="list-disc ml-5 text-gray-700 space-y-2">
                                <li><strong>Kardio:</strong> Lari atau naik tangga secara rutin.</li>
                                <li><strong>Otot:</strong> Fokus pada kekuatan kaki dan punggung.</li>
                            </ul>
                        </section>
                    </div>
                `
            },
            'panduan-medis.pdf': {
                title: 'Kesehatan & Pertolongan Pertama',
                content: `
                    <div class="space-y-6">
                        <section>
                            <h5 class="font-bold text-green-800 text-lg border-b-2 border-green-200 pb-2 mb-3">1. Hipotermia</h5>
                            <p class="text-sm">Ganti pakaian basah dengan kering, beri minuman hangat.</p>
                        </section>
                        <section>
                            <h5 class="font-bold text-green-800 text-lg border-b-2 border-green-200 pb-2 mb-3">2. AMS</h5>
                            <p class="text-sm">Jika pusing hebat dan mual, segera turun ketinggian.</p>
                        </section>
                    </div>
                `
            },
            'panduan-etika.pdf': {
                title: 'Etika Pendaki & Pelestarian',
                content: `
                    <div class="space-y-6">
                        <section>
                            <h5 class="font-bold text-green-800 text-lg border-b-2 border-green-200 pb-2 mb-3">7 Prinsip LNT</h5>
                            <ul class="list-disc ml-5 text-gray-700 space-y-2">
                                <li>Bawa turun semua sampah.</li>
                                <li>Jangan memetik bunga atau merusak alam.</li>
                                <li>Hormati ketenangan pendaki lain.</li>
                            </ul>
                        </section>
                    </div>
                `
            }
        };

        // Global functions for modal
        window.currentGuideFile = null;

        window.downloadFile = function(filename) {
            const guide = guides[filename];
            if (guide) {
                window.currentGuideFile = filename;
                const modal = document.getElementById('guide-modal');
                document.getElementById('modal-title').querySelector('span').innerText = guide.title;
                document.getElementById('modal-content').innerHTML = guide.content;
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            }
        };

        // Download PDF function
        window.downloadPdfFile = function() {
            if (!window.currentGuideFile) return;
            
            const filename = window.currentGuideFile;
            const guide = guides[filename];
            
            if (!guide) return;

            // Map filename to panduan type
            const typeMap = {
                'panduan-keselamatan.pdf': 'keselamatan',
                'panduan-teknis.pdf': 'teknis',
                'panduan-peralatan.pdf': 'peralatan',
                'panduan-fisik.pdf': 'fisik',
                'panduan-medis.pdf': 'medis',
                'panduan-etika.pdf': 'etika'
            };

            const type = typeMap[filename];
            if (!type) return;

            // Download file dari server
            const downloadUrl = `/api/download-panduan/${type}`;
            const link = document.createElement('a');
            link.href = downloadUrl;
            link.download = `Panduan-${type.charAt(0).toUpperCase() + type.slice(1)}.txt`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            
            // Show success notification
            window.showToast(`${guide.title} berhasil diunduh!`);
            
            // Close modal setelah beberapa saat
            setTimeout(() => {
                window.closeGuideModal();
            }, 1000);
        };

        window.closeGuideModal = function() {
            const modal = document.getElementById('guide-modal');
            if (modal) {
                modal.classList.add('hidden');
                document.body.style.overflow = '';
            }
        };

        // Toast notification function
        window.showToast = function(message) {
            const toast = document.getElementById('success-toast');
            const toastMessage = document.getElementById('toast-message');
            toastMessage.innerText = message;
            toast.classList.remove('hidden');
            
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3000);
        };

        // Close on background click
        document.getElementById('guide-modal').addEventListener('click', function(e) {
            if (e.target === this) window.closeGuideModal();
        });

        // Event listeners untuk tombol Install Panduan
        document.querySelectorAll('.install-panduan-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const filename = this.getAttribute('data-file');
                window.downloadFile(filename);
            });
        });

        // Event listener untuk tombol Download PDF
        const downloadPdfBtn = document.getElementById('download-pdf-btn');
        if (downloadPdfBtn) {
            downloadPdfBtn.addEventListener('click', window.downloadPdfFile);
        }

        // Event listener untuk tombol Tutup Modal
        const closeModalBtn = document.getElementById('close-modal-btn');
        if (closeModalBtn) {
            closeModalBtn.addEventListener('click', window.closeGuideModal);
        }

        // Event listener untuk tombol close di header
        const closeHeaderBtn = document.getElementById('close-header-btn');
        if (closeHeaderBtn) {
            closeHeaderBtn.addEventListener('click', window.closeGuideModal);
        }

        // Close guide modal dengan tombol close di header
        const closeGuideButtons = document.querySelectorAll('[onclick*="closeGuideModal"]');
        closeGuideButtons.forEach(btn => {
            btn.removeAttribute('onclick');
            btn.addEventListener('click', window.closeGuideModal);
        });
    </script>
</body>
</html>