<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Informasi Cuaca - SIMAKSI Gunung</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
      * {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      }
      .navbar-gradient {
        background: linear-gradient(135deg, #1e5631 0%, #2d7a3e 50%, #3a9f5d 100%);
      }
      .card-hover {
        transition: all 0.3s ease;
      }
      .card-hover:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(30, 86, 49, 0.15);
      }
      .btn-cta {
        background: linear-gradient(135deg, #1e5631 0%, #3a9f5d 100%);
        transition: all 0.3s ease;
      }
      .btn-cta:hover {
        transform: scale(1.05);
        box-shadow: 0 10px 25px rgba(30, 86, 49, 0.3);
      }
      
      /* Color indicators */
      .weather-safe {
        background-color: rgba(34, 197, 94, 0.1);
        border-left: 4px solid #22c55e;
      }
      .weather-warning {
        background-color: rgba(234, 179, 8, 0.1);
        border-left: 4px solid #eab308;
      }
      .weather-danger {
        background-color: rgba(239, 68, 68, 0.1);
        border-left: 4px solid #ef4444;
      }
      
      /* Forecast card */
      .forecast-card {
        transition: all 0.3s ease;
        position: relative;
      }
      .forecast-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
      }
      .forecast-card.rainy::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(180deg, rgba(59, 130, 246, 0.1) 0%, transparent 100%);
        border-radius: 1rem;
      }
    </style>
    <link rel="stylesheet" href="/css/style.css">
    <link href="/css/output.css" rel="stylesheet">
</head>
<body class="bg-white">
    <div class="min-h-screen">
        <!-- Navbar -->
        <header class="navbar-gradient text-white shadow-xl sticky top-0 z-50">
            <div class="container mx-auto flex justify-between items-center py-4 px-6">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center">
                        <i class="fas fa-mountain text-green-700 text-lg"></i>
                    </div>
                    <h1 class="text-2xl font-bold">SIMAKSI Gunung</h1>
                </div>
                <nav class="hidden md:block">
                    <ul class="flex space-x-8 font-semibold">
                        <li><a href="/" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-home"></i><span>Beranda</span></a></li>
                        <li><a href="/berita" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-newspaper"></i><span>Berita</span></a></li>
                        <li><a href="/pendakian" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-person-hiking"></i><span>Pendakian</span></a></li>
                        <li><a href="/cuaca" class="text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-cloud-sun"></i><span>Cuaca</span></a></li>
                        <li><a href="/status" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-chart-line"></i><span>Status</span></a></li>
                        <li><a href="/panduan" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-download"></i><span>Panduan</span></a></li>
                        <li><a href="/kontak" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-envelope"></i><span>Kontak</span></a></li>
                    </ul>
                </nav>
                <div class="flex space-x-4">
                    <% if (user) { %>
                        <!-- User Profile Dropdown -->
                        <div class="relative">
                            <button id="profile-btn" class="flex items-center space-x-3 bg-white text-green-700 px-4 py-2 rounded-lg font-semibold hover:bg-green-50 transition">
                                <div class="w-8 h-8 bg-green-600 rounded-full flex items-center justify-center">
                                    <i class="fas fa-user text-white text-sm"></i>
                                </div>
                                <span><%= user.nama %></span>
                                <i class="fas fa-chevron-down text-sm"></i>
                            </button>
                            <div id="profile-dropdown" class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 hidden z-50">
                                <div class="py-2">
                                    <div class="px-4 py-2 border-b border-gray-100">
                                        <p class="text-sm font-medium text-gray-900"><%= user.nama %></p>
                                        <p class="text-xs text-gray-500"><%= user.email %></p>
                                    </div>
                                    <a href="/profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition">
                                        <i class="fas fa-user-circle mr-2"></i>Profile Saya
                                    </a>
                                    <a href="/riwayat" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition">
                                        <i class="fas fa-history mr-2"></i>Riwayat Pendakian
                                    </a>
                                    <div class="border-t border-gray-100"></div>
                                    <a href="/logout" class="block px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition">
                                        <i class="fas fa-sign-out-alt mr-2"></i>Logout
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% } else { %>
                        <a href="/login" class="bg-white text-green-700 px-6 py-2 rounded-lg font-semibold hover:bg-green-50 transition">Login</a>
                    <% } %>
                </div>
            </div>
        </header>

        <!-- Hero Section -->
        <section class="bg-gradient-to-r from-green-600 to-green-800 text-white py-20 px-6">
            <div class="container mx-auto text-center">
                <h2 class="text-5xl md:text-6xl font-black mb-6 drop-shadow-lg">Informasi Cuaca</h2>
                <p class="text-xl md:text-2xl text-green-100 max-w-2xl mx-auto drop-shadow-md">Pantau kondisi cuaca terkini di setiap gunung dengan data realtime dari Open-Meteo API</p>
                <div class="mt-6 text-sm text-green-200 font-medium">
                    <i class="fas fa-sync-alt mr-2"></i>Update terakhir: <span id="update-time"><%= lastUpdate %></span>
                </div>
            </div>
        </section>

        <!-- Main Content Section -->
        <section class="py-20 bg-gray-50">
            <div class="container mx-auto px-6">
                <!-- Error Display -->
                <% if (error) { %>
                    <div class="bg-red-50 border-2 border-red-200 rounded-2xl p-8 mb-10 flex items-center gap-4">
                        <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-exclamation-circle text-red-600 text-xl"></i>
                        </div>
                        <div>
                            <p class="text-red-800 font-bold">Data cuaca sedang tidak tersedia</p>
                            <p class="text-red-700 text-sm">Silakan coba beberapa saat lagi. Kami sedang mengambil data dari server.</p>
                        </div>
                    </div>
                <% } %>

                <!-- Weather Cards Grid -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16">
                    <% gunung.forEach((item, index) => { %>
                        <div class="card-hover bg-white rounded-3xl shadow-lg overflow-hidden border border-gray-100">
                            <!-- Weather Status Header -->
                            <% 
                                let statusColor = 'green';
                                let statusText = 'Aman Pendakian';
                                let statusIcon = 'fa-check-circle';
                                let headerBg = 'from-green-600 to-green-700';
                                
                                // Determine weather status based on conditions
                                if (item.rainChance > 60 || item.condition.includes('Badai') || item.condition.includes('Hujan Lebat')) {
                                    statusColor = 'red';
                                    statusText = 'Bahaya';
                                    statusIcon = 'fa-exclamation-circle';
                                    headerBg = 'from-red-600 to-red-700';
                                } else if (item.windSpeed > 25 || item.condition.includes('Badai ringan') || item.rainChance > 40) {
                                    statusColor = 'yellow';
                                    statusText = 'Waspada';
                                    statusIcon = 'fa-alert-circle';
                                    headerBg = 'from-amber-500 to-amber-600';
                                } else if (item.condition.includes('Berawan') && item.rainChance > 20) {
                                    statusColor = 'yellow';
                                    statusText = 'Hati-hati';
                                    statusIcon = 'fa-cloud';
                                    headerBg = 'from-yellow-500 to-yellow-600';
                                }
                            %>
                            
                            <div class="bg-gradient-to-r <%= headerBg %> text-white p-8">
                                <div class="flex items-center justify-between mb-4">
                                    <div>
                                        <h3 class="text-3xl font-black mb-1"><%= item.mountain %></h3>
                                        <p class="text-white text-opacity-90 font-semibold flex items-center">
                                            <i class="fas fa-map-marker-alt mr-2"></i>
                                            <%= item.isRealTime ? 'Data Realtime' : 'Data Simulasi' %>
                                        </p>
                                    </div>
                                    <div class="text-right">
                                        <div class="text-5xl font-black flex items-center gap-2">
                                            <%= item.temperature %>°C
                                            <i class="<%= item.icon %> text-4xl"></i>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Status Badge -->
                                <div class="flex items-center gap-3 px-4 py-2 bg-white bg-opacity-20 rounded-xl w-fit">
                                    <i class="fas <%= statusIcon %> animate-pulse"></i>
                                    <span class="font-bold uppercase tracking-wide"><%= statusText %></span>
                                </div>
                            </div>

                            <!-- Weather Details -->
                            <div class="p-8">
                                <!-- Current Conditions -->
                                <div class="grid grid-cols-2 gap-4 mb-6">
                                    <div class="bg-blue-50 rounded-xl p-4 border border-blue-100">
                                        <p class="text-xs text-blue-600 font-bold uppercase mb-1">Kelembaban</p>
                                        <p class="text-2xl font-black text-gray-900"><%= item.humidity %>%</p>
                                    </div>
                                    <div class="bg-emerald-50 rounded-xl p-4 border border-emerald-100">
                                        <p class="text-xs text-emerald-600 font-bold uppercase mb-1">Kec. Angin</p>
                                        <p class="text-2xl font-black text-gray-900"><%= item.windSpeed %> km/h</p>
                                    </div>
                                    <div class="bg-purple-50 rounded-xl p-4 border border-purple-100">
                                        <p class="text-xs text-purple-600 font-bold uppercase mb-1">Peluang Hujan</p>
                                        <p class="text-2xl font-black text-gray-900"><%= item.rainChance %>%</p>
                                    </div>
                                    <div class="bg-orange-50 rounded-xl p-4 border border-orange-100">
                                        <p class="text-xs text-orange-600 font-bold uppercase mb-1">Presipitasi</p>
                                        <p class="text-2xl font-black text-gray-900"><%= Math.round(item.precipitation * 10) / 10 %> mm</p>
                                    </div>
                                </div>

                                <!-- Weather Condition Description -->
                                <div class="bg-gradient-to-r from-gray-50 to-gray-100 rounded-xl p-6 border border-gray-200 mb-6">
                                    <div class="flex items-center gap-4">
                                        <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center shadow-sm">
                                            <i class="<%= item.icon %> text-3xl" style="color: <% 
                                                if (item.color === 'green') { %>rgb(34, 197, 94)<% }
                                                else if (item.color === 'yellow') { %>rgb(234, 179, 8)<% }
                                                else if (item.color === 'red') { %>rgb(239, 68, 68)<% }
                                            %>"></i>
                                        </div>
                                        <div>
                                            <p class="text-xs text-gray-600 font-bold uppercase">Kondisi Cuaca</p>
                                            <p class="text-2xl font-black text-gray-900"><%= item.condition %></p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Weather Recommendation -->
                                <div class="<% if (statusColor === 'green') { %>weather-safe<% } else if (statusColor === 'yellow') { %>weather-warning<% } else { %>weather-danger<% } %> rounded-lg p-4 mb-4">
                                    <p class="font-bold text-sm mb-2">
                                        <% if (statusColor === 'green') { %>
                                            <i class="fas fa-check text-green-600 mr-2"></i>Kondisi Mendukung
                                        <% } else if (statusColor === 'yellow') { %>
                                            <i class="fas fa-exclamation-triangle text-yellow-600 mr-2"></i>Perlu Kewaspadaan
                                        <% } else { %>
                                            <i class="fas fa-exclamation-circle text-red-600 mr-2"></i>Tidak Disarankan
                                        <% } %>
                                    </p>
                                    <p class="text-xs text-gray-700">
                                        <% if (statusColor === 'green') { %>
                                            Kondisi cuaca saat ini mendukung untuk mendaki. Pastikan tetap terhidrasi dan gunakan perlengkapan standar.
                                        <% } else if (statusColor === 'yellow') { %>
                                            Kondisi cuaca kurang ideal. Pertimbangkan untuk menunda atau gunakan pemandu berpengalaman.
                                        <% } else { %>
                                            Kondisi cuaca berbahaya. Sangat tidak disarankan untuk mendaki pada saat ini. Tunda rencana pendakian Anda.
                                        <% } %>
                                    </p>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>

                <!-- 7-Day Forecast Section -->
                <% if (gunung.length > 0 && gunung[0].forecast && gunung[0].forecast.length > 0) { %>
                    <div class="mt-16">
                        <h3 class="text-4xl font-black text-gray-900 mb-8 text-center">
                            <i class="fas fa-calendar-alt text-blue-600 mr-3"></i>Prakiraan Cuaca 7 Hari
                        </h3>
                        
                        <!-- Forecast for first mountain -->
                        <div class="bg-white rounded-2xl p-8 shadow-lg mb-16">
                            <h4 class="text-2xl font-bold text-gray-900 mb-6"><%= gunung[0].mountain %></h4>
                            <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-4">
                                <% gunung[0].forecast.forEach((day, idx) => { %>
                                    <div class="forecast-card <%= day.precipitation > 5 ? 'rainy' : '' %> bg-gradient-to-br from-gray-50 to-gray-100 rounded-xl p-4 border border-gray-200 text-center">
                                        <p class="text-xs font-bold text-gray-500 uppercase mb-3">
                                            <%= new Date(day.date).toLocaleDateString('id-ID', { weekday: 'short', month: 'short', day: 'numeric' }) %>
                                        </p>
                                        
                                        <div class="flex justify-center mb-3">
                                            <div class="w-14 h-14 bg-white rounded-full flex items-center justify-center shadow-sm">
                                                <i class="<%= day.icon %> text-2xl" style="color: <% 
                                                    if (day.color === 'green') { %>rgb(34, 197, 94)<% }
                                                    else if (day.color === 'yellow') { %>rgb(234, 179, 8)<% }
                                                    else if (day.color === 'red') { %>rgb(239, 68, 68)<% }
                                                %>"></i>
                                            </div>
                                        </div>
                                        
                                        <p class="text-xs text-gray-600 font-semibold mb-3"><%= day.condition %></p>
                                        
                                        <div class="space-y-2 mb-3">
                                            <div class="flex justify-between items-center text-sm">
                                                <span class="text-gray-600 font-medium">Suhu</span>
                                                <span class="font-bold text-gray-900"><%= day.tempMax %>°</span>
                                            </div>
                                            <div class="flex justify-between items-center text-xs text-gray-500">
                                                <span>Min</span>
                                                <span><%= day.tempMin %>°</span>
                                            </div>
                                        </div>
                                        
                                        <div class="flex items-center justify-center gap-1 pt-2 border-t border-gray-200">
                                            <i class="fas fa-droplets text-blue-500 text-xs"></i>
                                            <span class="text-xs font-bold text-gray-700"><%= day.precipitation %> mm</span>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                    </div>
                <% } %>

                <!-- Weather Tips -->
                <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-3xl p-12">
                    <h4 class="text-3xl font-black text-center text-gray-900 mb-10">
                        <i class="fas fa-lightbulb text-yellow-500 mr-3"></i>Tips Cuaca untuk Pendakian
                    </h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                        <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-md transition">
                            <div class="w-14 h-14 bg-green-100 text-green-600 rounded-2xl flex items-center justify-center mb-6">
                                <i class="fas fa-sun text-2xl"></i>
                            </div>
                            <h5 class="text-xl font-bold text-gray-900 mb-3">Cuaca Hijau (Aman)</h5>
                            <p class="text-gray-600 text-sm leading-relaxed">Kondisi ideal untuk mendaki. Pastikan terhidrasi baik dan gunakan tabir surya untuk perlindungan UV.</p>
                        </div>
                        <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-md transition">
                            <div class="w-14 h-14 bg-yellow-100 text-yellow-600 rounded-2xl flex items-center justify-center mb-6">
                                <i class="fas fa-cloud-sun text-2xl"></i>
                            </div>
                            <h5 class="text-xl font-bold text-gray-900 mb-3">Cuaca Kuning (Waspada)</h5>
                            <p class="text-gray-600 text-sm leading-relaxed">Kondisi kurang ideal. Pertimbangkan untuk menundanya atau pergi lebih pagi sebelum cuaca memburuk.</p>
                        </div>
                        <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-md transition">
                            <div class="w-14 h-14 bg-red-100 text-red-600 rounded-2xl flex items-center justify-center mb-6">
                                <i class="fas fa-cloud-rain text-2xl"></i>
                            </div>
                            <h5 class="text-xl font-bold text-gray-900 mb-3">Cuaca Merah (Bahaya)</h5>
                            <p class="text-gray-600 text-sm leading-relaxed">Sangat tidak disarankan untuk mendaki. Tunda perjalanan hingga kondisi cuaca membaik.</p>
                        </div>
                        <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-md transition">
                            <div class="w-14 h-14 bg-blue-100 text-blue-600 rounded-2xl flex items-center justify-center mb-6">
                                <i class="fas fa-wind text-2xl"></i>
                            </div>
                            <h5 class="text-xl font-bold text-gray-900 mb-3">Persiapan Khusus</h5>
                            <p class="text-gray-600 text-sm leading-relaxed">Selalu bawa jaket windproof, layering pakaian, dan persiapan untuk kondisi ekstrem di ketinggian.</p>
                        </div>
                    </div>
                </div>

                <!-- Footer Note -->
                <div class="mt-16 bg-gradient-to-r from-green-50 to-emerald-50 rounded-2xl p-8 border border-green-200">
                    <p class="text-center text-gray-700 font-medium">
                        <i class="fas fa-info-circle text-blue-600 mr-2"></i>
                        Data cuaca diperbarui secara realtime menggunakan API Open-Meteo. Akurasi data tergantung pada kondisi jaringan dan lokasi koordinat gunung.
                    </p>
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer class="navbar-gradient text-white py-12">
            <div class="container mx-auto px-6">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
                    <div>
                        <h4 class="text-lg font-bold mb-4 flex items-center"><i class="fas fa-mountain mr-2"></i>SIMAKSI</h4>
                        <p class="text-green-100 text-sm">Platform terpercaya untuk mendaftar pendakian gunung di Indonesia</p>
                    </div>
                    <div>
                        <h4 class="text-lg font-bold mb-4">Navigasi</h4>
                        <ul class="space-y-2 text-green-100 text-sm">
                            <li><a href="/" class="hover:text-white transition">Beranda</a></li>
                            <li><a href="/berita" class="hover:text-white transition">Berita</a></li>
                            <li><a href="/pendakian" class="hover:text-white transition">Pendakian</a></li>
                            <li><a href="/kontak" class="hover:text-white transition">Kontak</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="text-lg font-bold mb-4">Bantuan</h4>
                        <ul class="space-y-2 text-green-100 text-sm">
                            <li><a href="/faq" class="hover:text-white transition">FAQ</a></li>
                            <li><a href="/panduan" class="hover:text-white transition">Panduan Pendakian</a></li>
                            <li><a href="/keselamatan" class="hover:text-white transition">Keselamatan</a></li>
                            <li><a href="/syarat-ketentuan" class="hover:text-white transition">Syarat & Ketentuan</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="text-lg font-bold mb-4">Hubungi Kami</h4>
                        <ul class="space-y-2 text-green-100 text-sm">
                            <li class="flex items-center"><i class="fas fa-phone mr-2"></i>+62 274 515 912</li>
                            <li class="flex items-center"><i class="fas fa-envelope mr-2"></i>info@simaksi.com</li>
                            <li class="flex items-center"><i class="fas fa-map-marker-alt mr-2"></i>Jakarta, Indonesia</li>
                        </ul>
                    </div>
                </div>
                <div class="border-t border-green-700 pt-8 text-center text-green-100 text-sm">
                    <p>&copy; 2026 SIMAKSI - Sistem Informasi Manajemen Pendakian Gunung. All rights reserved.</p>
                    <div class="flex justify-center space-x-4 mt-4">
                        <a href="#" class="hover:text-white transition"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="hover:text-white transition"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="hover:text-white transition"><i class="fab fa-youtube"></i></a>
                        <a href="#" class="hover:text-white transition"><i class="fab fa-twitter"></i></a>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script>
        // Profile dropdown
        const profileBtn = document.getElementById('profile-btn');
        const profileDropdown = document.getElementById('profile-dropdown');

        if (profileBtn && profileDropdown) {
            profileBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                profileDropdown.classList.toggle('hidden');
            });

            document.addEventListener('click', function(e) {
                if (!profileBtn.contains(e.target) && !profileDropdown.contains(e.target)) {
                    profileDropdown.classList.add('hidden');
                }
            });

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    profileDropdown.classList.add('hidden');
                }
            });
        }

        // Update time every minute
        function updateTime() {
            const now = new Date().toLocaleString('id-ID', {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit',
                timeZone: 'Asia/Jakarta'
            });
            document.getElementById('update-time').textContent = now;
        }
        
        // Update immediately and then every minute
        updateTime();
        setInterval(updateTime, 60000);
    </script>
</body>
</html>
