<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Informasi Cuaca - SIMAKSI Gunung Merbabu</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
      * {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      }
      .navbar-gradient {
        background: linear-gradient(135deg, #1e5631 0%, #2d7a3e 50%, #3a9f5d 100%);
      }
      .card-hover {
        transition: all 0.3s ease;
      }
      .card-hover:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(30, 86, 49, 0.15);
      }
      .btn-cta {
        background: linear-gradient(135deg, #1e5631 0%, #3a9f5d 100%);
        transition: all 0.3s ease;
      }
      .btn-cta:hover {
        transform: scale(1.05);
        box-shadow: 0 10px 25px rgba(30, 86, 49, 0.3);
      }
    </style>
    <link rel="stylesheet" href="/css/style.css">
    <link href="/css/output.css" rel="stylesheet">
</head>
<body class="bg-white">
    <div class="min-h-screen">
        <!-- Navbar -->
        <header class="navbar-gradient text-white shadow-xl sticky top-0 z-50">
            <div class="container mx-auto flex justify-between items-center py-4 px-6">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center">
                        <i class="fas fa-mountain text-green-700 text-lg"></i>
                    </div>
                    <h1 class="text-2xl font-bold">SIMAKSI Gunung</h1>
                </div>
                <nav class="hidden md:block">
                    <ul class="flex space-x-8 font-semibold">
                        <li><a href="/" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-home"></i><span>Beranda</span></a></li>
                        <li><a href="/berita" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-newspaper"></i><span>Berita</span></a></li>
                        <li><a href="/pendakian" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-person-hiking"></i><span>Pendakian</span></a></li>
                        <li><a href="/cuaca" class="text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-cloud-sun"></i><span>Cuaca</span></a></li>
                        <li><a href="/status" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-chart-line"></i><span>Status</span></a></li>
                        <li><a href="/panduan" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-download"></i><span>Panduan</span></a></li>
                        <li><a href="/kontak" class="hover:text-green-200 transition duration-300 flex items-center space-x-2"><i class="fas fa-envelope"></i><span>Kontak</span></a></li>
                    </ul>
                </nav>
                <div class="flex space-x-4">
                    <% if (user) { %>
                        <!-- User Profile Dropdown -->
                        <div class="relative">
                            <button id="profile-btn" class="flex items-center space-x-3 bg-white text-green-700 px-4 py-2 rounded-lg font-semibold hover:bg-green-50 transition">
                                <div class="w-8 h-8 bg-green-600 rounded-full flex items-center justify-center">
                                    <i class="fas fa-user text-white text-sm"></i>
                                </div>
                                <span><%= user.nama %></span>
                                <i class="fas fa-chevron-down text-sm"></i>
                            </button>
                            <div id="profile-dropdown" class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 hidden z-50">
                                <div class="py-2">
                                    <div class="px-4 py-2 border-b border-gray-100">
                                        <p class="text-sm font-medium text-gray-900"><%= user.nama %></p>
                                        <p class="text-xs text-gray-500"><%= user.email %></p>
                                    </div>
                                    <a href="/profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition">
                                        <i class="fas fa-user-circle mr-2"></i>Profile Saya
                                    </a>
                                    <a href="/riwayat" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition">
                                        <i class="fas fa-history mr-2"></i>Riwayat Pendakian
                                    </a>
                                    <div class="border-t border-gray-100"></div>
                                    <a href="/logout" class="block px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition">
                                        <i class="fas fa-sign-out-alt mr-2"></i>Logout
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% } else { %>
                        <a href="/login" class="bg-white text-green-700 px-6 py-2 rounded-lg font-semibold hover:bg-green-50 transition">Login</a>
                    <% } %>
                </div>
            </div>
        </header>

        <!-- Hero Section -->
        <section class="bg-gradient-to-r from-green-600 to-green-800 text-white py-20 px-6">
            <div class="container mx-auto text-center">
                <h2 class="text-5xl md:text-6xl font-black mb-6 drop-shadow-lg">Informasi Cuaca</h2>
                <p class="text-xl md:text-2xl text-green-100 max-w-2xl mx-auto drop-shadow-md">Pantau kondisi cuaca terkini di setiap gunung untuk perencanaan pendakian yang aman</p>
            </div>
        </section>

        <!-- Weather Information Section -->
        <section class="py-20 bg-white">
            <div class="container mx-auto px-6">
                <div class="text-center mb-16">
                    <h3 class="text-4xl font-bold text-gray-900 mb-4">Kondisi Cuaca Gunung</h3>
                    <p class="text-gray-600 text-lg">Informasi cuaca terkini dan prakiraan untuk membantu perencanaan pendakian Anda</p>
                </div>

                <!-- Current Weather Summary -->
                <div class="bg-gradient-to-r from-green-600 to-emerald-600 rounded-3xl p-10 text-white mb-16 shadow-2xl">
                    <div class="text-center mb-10">
                        <h4 class="text-3xl font-bold mb-2">Ringkasan Cuaca Hari Ini</h4>
                        <p class="text-green-100 font-medium">Update terakhir: <%= lastUpdate %></p>
                    </div>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
                        <div class="text-center bg-white bg-opacity-10 rounded-2xl p-6 backdrop-blur-sm">
                            <i class="fas fa-temperature-high text-4xl text-yellow-300 mb-3"></i>
                            <p class="text-sm text-green-100 font-bold uppercase tracking-widest">Suhu Rata-rata</p>
                            <p class="text-3xl font-black">18-25°C</p>
                        </div>
                        <div class="text-center bg-white bg-opacity-10 rounded-2xl p-6 backdrop-blur-sm">
                            <i class="fas fa-tint text-4xl text-blue-300 mb-3"></i>
                            <p class="text-sm text-green-100 font-bold uppercase tracking-widest">Kelembaban</p>
                            <p class="text-3xl font-black">65-85%</p>
                        </div>
                        <div class="text-center bg-white bg-opacity-10 rounded-2xl p-6 backdrop-blur-sm">
                            <i class="fas fa-wind text-4xl text-emerald-300 mb-3"></i>
                            <p class="text-sm text-green-100 font-bold uppercase tracking-widest">Kec. Angin</p>
                            <p class="text-3xl font-black">5-15 km/h</p>
                        </div>
                        <div class="text-center bg-white bg-opacity-10 rounded-2xl p-6 backdrop-blur-sm">
                            <i class="fas fa-cloud text-4xl text-gray-200 mb-3"></i>
                            <p class="text-sm text-green-100 font-bold uppercase tracking-widest">Kondisi Umum</p>
                            <p class="text-3xl font-black">Berawan</p>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 mb-16">
                    <% gunung.forEach((item, index) => { %>
                        <div class="card-hover bg-white rounded-3xl shadow-xl overflow-hidden border border-gray-100">
                            <!-- Mountain Header -->
                            <div class="bg-gradient-to-r from-green-700 to-green-800 text-white p-8">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <h4 class="text-3xl font-black mb-1 tracking-tight"><%= item.mountain %></h4>
                                        <p class="text-green-200 text-sm font-medium"><i class="fas fa-map-marker-alt mr-2 text-green-400"></i>Wilayah Gunung</p>
                                    </div>
                                    <div class="text-right">
                                        <div class="text-5xl font-black flex items-center gap-3 drop-shadow-lg">
                                            <%= item.temperature %>°C
                                            <i class="<%= item.icon %> text-4xl text-yellow-300"></i>
                                        </div>
                                        <div class="text-xs text-green-200 font-bold uppercase tracking-widest mt-1">Suhu Saat Ini</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Weather Details -->
                            <div class="p-8">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                                    <!-- Temperature Details -->
                                    <div class="bg-blue-50 rounded-2xl p-6 border border-blue-100">
                                        <div class="flex items-center mb-4">
                                            <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center mr-3">
                                                <i class="fas fa-thermometer-half text-blue-600"></i>
                                            </div>
                                            <span class="font-bold text-gray-900">Rincian Suhu</span>
                                        </div>
                                        <div class="space-y-3 text-sm">
                                            <div class="flex justify-between items-center pb-2 border-b border-blue-200 border-opacity-30">
                                                <span class="text-gray-600 font-medium">Minimum</span>
                                                <span class="font-bold text-gray-900"><%= item.tempMin %>°C</span>
                                            </div>
                                            <div class="flex justify-between items-center pb-2 border-b border-blue-200 border-opacity-30">
                                                <span class="text-gray-600 font-medium">Maksimum</span>
                                                <span class="font-bold text-gray-900"><%= item.tempMax %>°C</span>
                                            </div>
                                            <div class="flex justify-between items-center">
                                                <span class="text-gray-600 font-medium">Terasa Seperti</span>
                                                <span class="font-bold text-gray-900"><%= item.feelsLike %>°C</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Wind & Humidity -->
                                    <div class="bg-emerald-50 rounded-2xl p-6 border border-emerald-100">
                                        <div class="flex items-center mb-4">
                                            <div class="w-10 h-10 bg-emerald-100 rounded-full flex items-center justify-center mr-3">
                                                <i class="fas fa-wind text-emerald-600"></i>
                                            </div>
                                            <span class="font-bold text-gray-900">Kondisi Udara</span>
                                        </div>
                                        <div class="space-y-3 text-sm">
                                            <div class="flex justify-between items-center pb-2 border-b border-emerald-200 border-opacity-30">
                                                <span class="text-gray-600 font-medium">Kec. Angin</span>
                                                <span class="font-bold text-gray-900"><%= item.windSpeed %> km/h</span>
                                            </div>
                                            <div class="flex justify-between items-center pb-2 border-b border-emerald-200 border-opacity-30">
                                                <span class="text-gray-600 font-medium">Arah Angin</span>
                                                <span class="font-bold text-gray-900"><%= item.windDirection %></span>
                                            </div>
                                            <div class="flex justify-between items-center">
                                                <span class="text-gray-600 font-medium">Kelembaban</span>
                                                <span class="font-bold text-gray-900"><%= item.humidity %>%</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Weather Condition & Status -->
                                <div class="bg-gray-50 rounded-2xl p-6 mb-8 border border-gray-200">
                                    <div class="flex items-center justify-between mb-6">
                                        <div class="flex items-center">
                                            <div class="w-12 h-12 bg-white rounded-xl shadow-sm flex items-center justify-center mr-4">
                                                <i class="<%= item.icon %> text-2xl text-green-600"></i>
                                            </div>
                                            <div>
                                                <p class="font-black text-gray-900 text-lg uppercase tracking-tight">Kondisi Cuaca</p>
                                                <p class="text-sm text-gray-600 font-medium"><%= item.condition %></p>
                                            </div>
                                        </div>
                                        <div class="text-right">
                                            <div class="inline-flex items-center px-4 py-2 rounded-xl text-xs font-black uppercase tracking-widest shadow-sm
                                                <% let statusClass = 'bg-green-500';
                                                   if (item.windSpeed > 20 || item.condition.includes('Badai') || item.condition.includes('Hujan Deras')) {
                                                       statusClass = 'bg-red-500';
                                                   } else if (item.condition.includes('Hujan Sedang')) {
                                                       statusClass = 'bg-orange-500';
                                                   } else if (item.condition.includes('Berawan Tebal') || item.windSpeed > 15) {
                                                       statusClass = 'bg-yellow-500';
                                                   } %>
                                                <%= statusClass %> text-white">
                                                <i class="fas fa-circle mr-2 text-[10px] animate-pulse"></i>
                                                <% if (statusClass === 'bg-green-500') { %>
                                                    Aman Pendakian
                                                <% } else if (statusClass === 'bg-yellow-500') { %>
                                                    Waspada
                                                <% } else if (statusClass === 'bg-orange-500') { %>
                                                    Siaga
                                                <% } else { %>
                                                    Bahaya
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Additional Weather Info -->
                                    <div class="grid grid-cols-3 gap-6 text-center">
                                        <div class="p-3 bg-white rounded-xl shadow-sm">
                                            <i class="fas fa-eye text-blue-500 text-xl mb-2"></i>
                                            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mb-1">Visibilitas</p>
                                            <p class="font-black text-gray-900"><%= item.visibility %> km</p>
                                        </div>
                                        <div class="p-3 bg-white rounded-xl shadow-sm">
                                            <i class="fas fa-tachometer-alt text-purple-500 text-xl mb-2"></i>
                                            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mb-1">Tekanan</p>
                                            <p class="font-black text-gray-900"><%= item.pressure %> hPa</p>
                                        </div>
                                        <div class="p-3 bg-white rounded-xl shadow-sm">
                                            <i class="fas fa-cloud text-gray-400 text-xl mb-2"></i>
                                            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mb-1">Awan</p>
                                            <p class="font-black text-gray-900"><%= item.clouds %>%</p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Sunrise & Sunset -->
                                <div class="bg-gradient-to-r from-orange-50 to-amber-50 rounded-2xl p-6 border border-orange-100">
                                    <div class="grid grid-cols-2 gap-4">
                                        <div class="flex items-center space-x-4">
                                            <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-sm">
                                                <i class="fas fa-sun text-orange-500 text-lg"></i>
                                            </div>
                                            <div>
                                                <p class="text-[10px] text-orange-600 font-bold uppercase tracking-widest">Terbit</p>
                                                <p class="font-black text-gray-900">
                                                    <%= item.sunrise.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="flex items-center space-x-4">
                                            <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-sm">
                                                <i class="fas fa-moon text-indigo-500 text-lg"></i>
                                            </div>
                                            <div>
                                                <p class="text-[10px] text-indigo-600 font-bold uppercase tracking-widest">Terbenam</p>
                                                <p class="font-black text-gray-900">
                                                    <%= item.sunset.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>

                <!-- 7-Day Forecast -->
                <div class="bg-gray-50 rounded-3xl p-10 mb-16 shadow-inner">
                    <h4 class="text-3xl font-black text-gray-900 mb-10 text-center">
                        <i class="fas fa-calendar-alt text-blue-600 mr-3"></i>Prakiraan Cuaca 7 Hari
                    </h4>
                    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-6">
                        <% const days = ['Hari Ini', 'Besok', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat'];
                           const forecastTemps = [
                               { min: 18, max: 26 }, { min: 19, max: 27 }, { min: 17, max: 25 },
                               { min: 20, max: 28 }, { min: 18, max: 26 }, { min: 21, max: 29 }, { min: 19, max: 27 }
                           ];
                           const forecastConditions = ['Cerah', 'Berawan', 'Hujan', 'Cerah', 'Berawan', 'Cerah', 'Hujan'];

                           days.forEach((day, index) => { %>
                            <div class="text-center p-6 bg-white rounded-2xl shadow-sm hover:shadow-md transition">
                                <p class="font-bold text-gray-900 mb-3 uppercase tracking-tighter text-sm"><%= day %></p>
                                <div class="w-12 h-12 bg-blue-50 rounded-full flex items-center justify-center mx-auto mb-3">
                                    <i class="fas fa-<%= forecastConditions[index] === 'Cerah' ? 'sun text-yellow-500' : forecastConditions[index] === 'Berawan' ? 'cloud text-blue-400' : 'cloud-rain text-blue-600' %> text-xl"></i>
                                </div>
                                <p class="text-xs text-gray-500 font-bold mb-3 uppercase"><%= forecastConditions[index] %></p>
                                <div class="flex justify-center items-end gap-1">
                                    <span class="text-xl font-black text-gray-900"><%= forecastTemps[index].max %>°</span>
                                    <span class="text-xs font-bold text-gray-400 mb-1">/ <%= forecastTemps[index].min %>°</span>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>

                <!-- Weather Tips -->
                <div class="mt-20 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-3xl p-12">
                    <h4 class="text-3xl font-black text-center text-gray-900 mb-10">
                        <i class="fas fa-lightbulb text-yellow-500 mr-3"></i>Tips Cuaca untuk Pendakian
                    </h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                        <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-md transition">
                            <div class="w-14 h-14 bg-yellow-100 text-yellow-600 rounded-2xl flex items-center justify-center mb-6">
                                <i class="fas fa-sun text-2xl"></i>
                            </div>
                            <h5 class="text-xl font-bold text-gray-900 mb-3">Cuaca Cerah</h5>
                            <p class="text-gray-600 text-sm leading-relaxed">Kondisi ideal untuk pendakian. Pastikan tetap terhidrasi dengan baik dan gunakan tabir surya.</p>
                        </div>
                        <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-md transition">
                            <div class="w-14 h-14 bg-blue-100 text-blue-600 rounded-2xl flex items-center justify-center mb-6">
                                <i class="fas fa-cloud-rain text-2xl"></i>
                            </div>
                            <h5 class="text-xl font-bold text-gray-900 mb-3">Cuaca Hujan</h5>
                            <p class="text-gray-600 text-sm leading-relaxed">Tunda pendakian jika memungkinkan. Gunakan jas hujan berkualitas dan lindungi peralatan elektronik.</p>
                        </div>
                        <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-md transition">
                            <div class="w-14 h-14 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center mb-6">
                                <i class="fas fa-wind text-2xl"></i>
                            </div>
                            <h5 class="text-xl font-bold text-gray-900 mb-3">Angin Kencang</h5>
                            <p class="text-gray-600 text-sm leading-relaxed">Waspadai angin kencang di area terbuka. Gunakan windbreaker dan pastikan tenda terpasang kuat.</p>
                        </div>
                        <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-md transition">
                            <div class="w-14 h-14 bg-red-100 text-red-600 rounded-2xl flex items-center justify-center mb-6">
                                <i class="fas fa-thermometer-half text-2xl"></i>
                            </div>
                            <h5 class="text-xl font-bold text-gray-900 mb-3">Suhu Dingin</h5>
                            <p class="text-gray-600 text-sm leading-relaxed">Gunakan pakaian berlapis (layering system) dan siapkan thermal blanket untuk kondisi ekstrem.</p>
                        </div>
                    </div>
                </div>

                <!-- Weather Warnings -->
                <div class="mt-12 bg-white rounded-3xl p-10 border-2 border-red-100 shadow-xl relative overflow-hidden">
                    <div class="absolute top-0 right-0 p-4 opacity-10">
                        <i class="fas fa-exclamation-triangle text-9xl text-red-600"></i>
                    </div>
                    <div class="flex items-start relative z-10">
                        <div class="w-16 h-16 bg-red-600 text-white rounded-2xl flex items-center justify-center mr-6 flex-shrink-0 shadow-lg">
                            <i class="fas fa-bell text-2xl animate-bounce"></i>
                        </div>
                        <div>
                            <h4 class="text-2xl font-black text-gray-900 mb-4">Peringatan Cuaca Terkini</h4>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-gray-700 font-medium">
                                <p class="flex items-center"><i class="fas fa-circle text-[8px] text-red-500 mr-3"></i>Potensi hujan lebat di wilayah lereng gunung sore hari.</p>
                                <p class="flex items-center"><i class="fas fa-circle text-[8px] text-red-500 mr-3"></i>Suhu ekstrem di puncak pada malam hari (di bawah 8°C).</p>
                                <p class="flex items-center"><i class="fas fa-circle text-[8px] text-red-500 mr-3"></i>Angin kencang di jalur pendakian terbuka (>25 km/h).</p>
                                <p class="flex items-center"><i class="fas fa-circle text-[8px] text-red-500 mr-3"></i>Kabut tebal yang dapat mengurangi jarak pandang (<10m).</p>
                            </div>
                            <div class="mt-8">
                                <button onclick="toggleWarningModal()" class="bg-red-600 text-white px-8 py-3 rounded-xl font-black uppercase tracking-widest hover:bg-red-700 transition shadow-lg">
                                    <i class="fas fa-exclamation-circle mr-2"></i>Detail Peringatan
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Warning Modal -->
        <div id="warning-modal" class="fixed inset-0 z-[100] hidden">
            <div class="absolute inset-0 bg-black bg-opacity-60 backdrop-blur-sm" onclick="toggleWarningModal()"></div>
            <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-2xl px-6">
                <div class="bg-white rounded-[2.5rem] overflow-hidden shadow-2xl">
                    <div class="bg-red-600 p-8 text-white relative">
                        <button onclick="toggleWarningModal()" class="absolute top-6 right-6 text-white hover:text-red-100 transition">
                            <i class="fas fa-times text-2xl"></i>
                        </button>
                        <div class="flex items-center gap-4 mb-4">
                            <div class="w-14 h-14 bg-white bg-opacity-20 rounded-2xl flex items-center justify-center">
                                <i class="fas fa-exclamation-triangle text-3xl"></i>
                            </div>
                            <div>
                                <h3 class="text-3xl font-black uppercase tracking-tighter">Detail Peringatan</h3>
                                <p class="text-red-100 font-bold uppercase tracking-widest text-xs">Update: <%= lastUpdate %></p>
                            </div>
                        </div>
                    </div>
